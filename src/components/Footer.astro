---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div>
		<strong>Made with curiosity.</strong>
		<span>Engineering, riding, and things worth keeping.</span>
	</div>
	<nav aria-label="Footer navigation">
		<a href="mailto:equationzhao@foxmail.com">Email</a>
		<a href="https://github.com/Equationzhao" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
		<a href="/rss.xml">RSS</a>
	</nav>
	<p>© {year} Equationzhao</p>
</footer>

<style>
	.site-footer {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: end;
		gap: 1.5rem;
		width: min(1160px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 1.5rem 0 2.5rem;
		border-top: 1px solid rgba(var(--border), 0.38);
		color: rgb(var(--gray));
		font-family: var(--font-display);
		font-size: 0.78rem;
	}

	.site-footer strong,
	.site-footer span {
		display: block;
	}

	.site-footer strong {
		margin-bottom: 0.22rem;
		color: rgb(var(--gray-dark));
		font-weight: 600;
	}

	.site-footer nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.site-footer a {
		min-height: 32px;
		color: rgb(var(--gray));
		line-height: 32px;
		text-decoration: none;
	}

	.site-footer a:hover {
		color: rgb(var(--gray-dark));
		text-shadow: none;
	}

	.site-footer p {
		margin: 0;
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		.site-footer {
			grid-template-columns: 1fr;
			align-items: start;
			gap: 0.85rem;
			width: min(100% - 1.5rem, 1160px);
			padding-bottom: 1.5rem;
		}

		.site-footer a {
			min-height: 44px;
			line-height: 44px;
		}
	}
</style>
