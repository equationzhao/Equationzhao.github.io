---
import { Seo } from 'astro-seo-meta';
import { ClientRouter } from 'astro:transitions';
import CommandPalette from './CommandPalette.astro';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<Seo
		title="Eq's Blog"
		description="Equationzhao blog site"
		keywords={['website', 'blog', 'astro']}
		icon="/favicon.svg"
	/>
	<ClientRouter />
	<nav class="site-nav" aria-label="Primary navigation">
		<a class="site-brand" href="/" rel="prefetch-intent" aria-label="Equationzhao home">
			<span class="brand-mark" aria-hidden="true">∑</span>
			<span>Equationzhao</span>
		</a>

		<div class="primary-links">
			<HeaderLink href="/blog" rel="prefetch-intent">Writing</HeaderLink>
			<HeaderLink href="/apps" rel="prefetch-intent">Tools</HeaderLink>
			<HeaderLink href="/about" rel="prefetch-intent">About</HeaderLink>
		</div>

		<div class="nav-actions">
			<CommandPalette />
			<div class="appearance-switcher">
				<button
					id="theme-toggle"
					class="theme-toggle-btn"
					type="button"
					aria-label="Change appearance"
					aria-haspopup="listbox"
					aria-expanded="false"
					aria-controls="theme-menu"
				>
					<span class="theme-swatch" aria-hidden="true"></span>
					<span class="theme-label">Night Console</span>
					<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 9.5 5 5 5-5" /></svg>
				</button>
				<div id="theme-menu" class="theme-menu" role="listbox" aria-label="Appearance" hidden>
					<button class="theme-option is-selected" type="button" role="option" data-theme-value="night-console">
						<span class="theme-option-swatch swatch-night" aria-hidden="true"></span>
						<span><strong>Night Console</strong><small>Ink, paper and route green</small></span>
					</button>
					<button class="theme-option" type="button" role="option" data-theme-value="crt-terminal">
						<span class="theme-option-swatch swatch-crt" aria-hidden="true"></span>
						<span><strong>CRT Terminal</strong><small>Amber phosphor and scanlines</small></span>
					</button>
					<button class="theme-option" type="button" role="option" data-theme-value="racing-dashboard">
						<span class="theme-option-swatch swatch-racing" aria-hidden="true"></span>
						<span><strong>Racing Dashboard</strong><small>Telemetry cyan and speed orange</small></span>
					</button>
					<button class="theme-option" type="button" role="option" data-theme-value="alpine-brevet">
						<span class="theme-option-swatch swatch-alpine" aria-hidden="true"></span>
						<span><strong>Alpine Brevet</strong><small>Paper, contour blue and summit orange</small></span>
					</button>
				</div>
			</div>
		</div>
	</nav>
	<script is:inline defer src="/theme-toggle.js"></script>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid rgba(var(--border), 0.34);
		background: rgba(var(--surface-0), 0.9);
		backdrop-filter: blur(18px) saturate(120%);
	}

	.site-nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1.5rem;
		width: min(1160px, calc(100% - 2.5rem));
		min-height: 68px;
		margin: 0 auto;
	}

	.site-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		width: fit-content;
		color: rgb(var(--gray-dark));
		font-family: var(--font-display);
		font-weight: 650;
		letter-spacing: -0.025em;
		text-decoration: none;
	}

	.site-brand:hover {
		color: rgb(var(--gray-dark));
		text-shadow: none;
	}

	.brand-mark {
		display: grid;
		width: 30px;
		height: 30px;
		place-items: center;
		border-radius: 50%;
		background: rgb(var(--accent));
		color: rgb(var(--accent-ink));
		font-family: var(--font-display);
		font-size: 0.82rem;
		font-weight: 700;
	}

	.primary-links,
	.nav-actions {
		display: flex;
		align-items: center;
	}

	.primary-links {
		gap: 1.5rem;
	}

	.primary-links :global(a) {
		position: relative;
		min-height: 44px;
		padding: 0;
		color: rgb(var(--gray));
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 44px;
		text-decoration: none;
	}

	.primary-links :global(a::after) {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 6px;
		height: 2px;
		background: rgb(var(--accent));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.18s ease;
	}

	.primary-links :global(a:hover),
	.primary-links :global(a.active) {
		color: rgb(var(--gray-dark));
		text-shadow: none;
	}

	.primary-links :global(a:hover::after),
	.primary-links :global(a.active::after) {
		transform: scaleX(1);
	}

	.nav-actions {
		justify-content: flex-end;
		gap: 0.5rem;
	}

	.appearance-switcher {
		position: relative;
	}

	.theme-toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.48rem;
		min-height: 44px;
		padding: 0 0.7rem;
		border: 1px solid rgba(var(--border), 0.38);
		border-radius: 999px;
		background: rgba(var(--surface-1), 0.7);
		color: rgb(var(--gray));
		font: 500 0.75rem var(--font-display);
		cursor: pointer;
	}

	.theme-toggle-btn:hover,
	.theme-toggle-btn[aria-expanded='true'] {
		border-color: rgba(var(--accent), 0.58);
		color: rgb(var(--gray-dark));
		background: rgba(var(--accent), 0.08);
	}

	.theme-toggle-btn svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		transition: transform 0.18s ease;
	}

	.theme-toggle-btn[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}

	.theme-swatch,
	.theme-option-swatch {
		display: block;
		flex: 0 0 auto;
		border-radius: 50%;
	}

	.theme-swatch {
		width: 14px;
		height: 14px;
		background: linear-gradient(135deg, rgb(var(--accent)), rgb(var(--accent-strong)));
		box-shadow: 0 0 0 1px rgba(var(--border), 0.42);
	}

	.theme-menu {
		position: absolute;
		top: calc(100% + 0.6rem);
		right: 0;
		z-index: 60;
		width: 272px;
		padding: 0.42rem;
		border: 1px solid rgba(var(--border), 0.42);
		border-radius: 14px;
		background: rgb(var(--surface-1));
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.34);
	}

	.theme-option {
		display: grid;
		grid-template-columns: 20px 1fr;
		gap: 0.7rem;
		align-items: center;
		width: 100%;
		min-height: 52px;
		padding: 0.55rem 0.65rem;
		border: 1px solid transparent;
		border-radius: 10px;
		background: transparent;
		color: rgb(var(--gray-dark));
		text-align: left;
		cursor: pointer;
	}

	.theme-option:hover,
	.theme-option.is-selected {
		border-color: rgba(var(--accent), 0.28);
		background: rgba(var(--accent), 0.08);
	}

	.theme-option strong,
	.theme-option small {
		display: block;
	}

	.theme-option strong {
		font: 600 0.82rem var(--font-display);
	}

	.theme-option small {
		margin-top: 0.12rem;
		color: rgb(var(--gray));
		font-size: 0.7rem;
		line-height: 1.3;
	}

	.theme-option-swatch {
		width: 18px;
		height: 18px;
	}

	.swatch-night { background: linear-gradient(135deg, #2fcf91, #f2eee3); }
	.swatch-crt { background: linear-gradient(135deg, #f0b35a, #7fe07a); }
	.swatch-racing { background: linear-gradient(135deg, #26e0c2, #ff7a2f); }
	.swatch-alpine { background: linear-gradient(135deg, #f7f8f2 0 38%, #198fd8 38% 72%, #f27135 72%); }

	@media (max-width: 720px) {
		.site-nav {
			grid-template-columns: 1fr auto;
			gap: 0.25rem 0.75rem;
			width: min(100% - 1.5rem, 1160px);
			padding-top: 0.35rem;
		}

		.primary-links {
			grid-column: 1 / -1;
			grid-row: 2;
			justify-content: space-between;
			border-top: 1px solid rgba(var(--border), 0.25);
		}

		.primary-links :global(a) {
			flex: 1;
			text-align: center;
		}

		.nav-actions {
			grid-column: 2;
			grid-row: 1;
		}

		.theme-label,
		.theme-toggle-btn svg {
			display: none;
		}

		.theme-toggle-btn {
			width: 44px;
			padding: 0;
		}

		.theme-menu {
			right: 0;
			width: min(272px, calc(100vw - 1.5rem));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.primary-links :global(a::after),
		.theme-toggle-btn svg {
			transition: none;
		}
	}
</style>
