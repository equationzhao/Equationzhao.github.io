---
import { Seo } from "astro-seo-meta";
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE } from '../consts';
import CommandPalette from './CommandPalette.astro';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<Seo
		title="Eq's Blog"
		description="Equationzhao blog site"
		keywords={["website", "blog", "astro"]}
		icon="/favicon.svg"
	/>
	<nav>
		<h2 class="brand">
			<a href="/" rel = prefetch-intent>{SITE_TITLE}</a>
			<em>好的方程列出来有诗の美感</em>
		</h2>
		<ClientRouter />
		<div class="internal-links">
			<HeaderLink href="/" rel = prefetch-intent>Home</HeaderLink>
			<HeaderLink href="/blog" rel = prefetch-intent>Posts</HeaderLink>
			<HeaderLink href="/apps" rel = prefetch-intent>Apps</HeaderLink>
			<HeaderLink href="/about" rel = prefetch-intent>About</HeaderLink>
			<HeaderLink href="https://rxresu.me/equationzhao/equationzhao" rel = prefetch-intent target={'_blank'}>Hire ME!</HeaderLink>
		</div>
		<div class="social-links">
			<div class="appearance-switcher">
				<button id="theme-toggle" class="theme-toggle-btn" type="button" aria-label="Change appearance" aria-haspopup="listbox" aria-expanded="false" aria-controls="theme-menu">
					<span class="theme-swatch" aria-hidden="true"></span>
					<span class="theme-label">Night Console</span>
					<svg class="theme-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
				</button>
				<div id="theme-menu" class="theme-menu" role="listbox" aria-label="Appearance" hidden>
					<button class="theme-option is-selected" type="button" role="option" data-theme-value="night-console">
						<span class="theme-option-swatch swatch-night" aria-hidden="true"></span>
						<span>
							<strong>Night Console</strong>
							<small>Current glass terminal</small>
						</span>
					</button>
					<button class="theme-option" type="button" role="option" data-theme-value="crt-terminal">
						<span class="theme-option-swatch swatch-crt" aria-hidden="true"></span>
						<span>
							<strong>CRT Terminal</strong>
							<small>Amber phosphor and scanlines</small>
						</span>
					</button>
					<button class="theme-option" type="button" role="option" data-theme-value="racing-dashboard">
						<span class="theme-option-swatch swatch-racing" aria-hidden="true"></span>
						<span>
							<strong>Racing Dashboard</strong>
							<small>Telemetry panels and speed color</small>
						</span>
					</button>
					<button class="theme-option" type="button" role="option" data-theme-value="alpine-brevet">
						<span class="theme-option-swatch swatch-alpine" aria-hidden="true"></span>
						<span>
							<strong>Alpine Brevet</strong>
							<small>Routes, contours and summit color</small>
						</span>
					</button>
				</div>
			</div>
			<a href="https://github.com/Equationzhao" target="_blank" rel = prefetch-intent>
				<span class="sr-only">Go to Eq's GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
			</a>
			<a href="/rss.xml" target="_blank" rel = prefetch-intent>
				<span class="sr-only">RSS</span>
				<svg class="icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="4209" width="32" height="32"><path d="M928 0H96C43.2 0 0 43.2 0 96v832c0 52.8 43.2 96 96 96h832c52.8 0 96-43.2 96-96V96c0-52.8-43.2-96-96-96zM279.008 831.2A86.72 86.72 0 0 1 192 744.608a87.04 87.04 0 0 1 174.016 0 86.72 86.72 0 0 1-87.008 86.592z m218.4 0.8a304.192 304.192 0 0 0-89.408-216.384 303.36 303.36 0 0 0-216-89.6v-125.184c237.6 0 431.2 193.408 431.2 431.2h-125.792z m222.208 0c0-291.008-236.608-528-527.392-528V178.816c360 0 652.992 293.184 652.992 653.216h-125.6z" ></path></svg>
			</a>
		</div>
	</nav>
	<CommandPalette />
	<script is:inline defer src="/theme-toggle.js"></script>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		margin: 0;
		padding: 0 1.2rem;
		background: rgba(var(--surface-1), 0.78);
		border-bottom: 1px solid rgba(var(--border), 0.28);
		backdrop-filter: blur(12px);
		box-shadow: 0 8px 24px rgba(2, 5, 14, 0.35);
	}
	.brand {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		font-size: 1rem;
	}
	.brand a,
	.brand a.active {
		text-decoration: none;
		color: rgb(237, 243, 255);
		letter-spacing: 0.02em;
	}
	.brand em {
		font-size: 0.75rem;
		font-style: normal;
		color: rgba(var(--gray), 0.9);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		min-height: 72px;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem;
		border-radius: 999px;
		background: rgba(var(--surface-0), 0.56);
		border: 1px solid rgba(var(--border), 0.2);
	}
	nav a {
		padding: 0.55rem 0.9rem;
		color: rgb(var(--gray-dark));
		border-radius: 999px;
		text-decoration: none;
		transition: color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
	}
	nav a.active {
		background: rgba(var(--accent-strong), 0.22);
		color: rgb(237, 244, 255);
		box-shadow: 0 0 0 1px rgba(var(--accent), 0.45) inset, 0 0 14px rgba(var(--accent), 0.24);
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.social-links a {
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--accent));
	}
	:global(.theme-toggle-btn) {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		height: 34px;
		padding: 0 0.65rem 0 0.5rem;
		background: rgba(var(--surface-0), 0.62);
		border: 1px solid rgba(var(--border), 0.25);
		color: rgb(var(--gray));
		cursor: pointer;
		border-radius: 999px;
		transition: color 0.2s, background-color 0.2s, border-color 0.2s, box-shadow 0.2s;
	}
	:global(.theme-toggle-btn:hover) {
		color: rgb(var(--accent));
		background: rgba(var(--accent), 0.1);
		border-color: rgba(var(--accent), 0.42);
	}
	:global(.theme-toggle-btn[aria-expanded="true"]) {
		color: rgb(var(--accent));
		border-color: rgba(var(--accent), 0.48);
		box-shadow: 0 0 0 1px rgba(var(--accent), 0.15), 0 0 18px rgba(var(--accent), 0.16);
	}
	:global(.theme-swatch),
	:global(.theme-option-swatch) {
		display: block;
		border-radius: 999px;
		background: linear-gradient(135deg, rgb(var(--accent)), rgb(var(--accent-strong)));
		box-shadow: 0 0 0 1px rgba(var(--border), 0.32) inset;
	}
	:global(.theme-swatch) {
		width: 14px;
		height: 14px;
	}
	:global(.theme-label) {
		max-width: 9rem;
		font-size: 0.78rem;
		font-weight: 700;
		white-space: nowrap;
	}
	:global(.theme-chevron) {
		transition: transform 0.2s ease;
	}
	:global(.theme-toggle-btn[aria-expanded="true"] .theme-chevron) {
		transform: rotate(180deg);
	}
	:global(.appearance-switcher) {
		position: relative;
	}
	:global(.theme-menu) {
		position: absolute;
		top: calc(100% + 0.65rem);
		right: 0;
		z-index: 40;
		width: 260px;
		padding: 0.45rem;
		border: 1px solid rgba(var(--border), 0.32);
		border-radius: var(--radius-md);
		background: rgba(var(--surface-1), 0.96);
		box-shadow: 0 20px 54px rgba(0, 0, 0, 0.42), 0 0 0 1px rgba(var(--border), 0.18);
		backdrop-filter: blur(16px);
		transform-origin: top right;
		animation: theme-menu-in 0.18s ease-out;
	}
	:global(.theme-option) {
		display: grid;
		grid-template-columns: 22px 1fr;
		gap: 0.65rem;
		align-items: center;
		width: 100%;
		padding: 0.65rem;
		border: 1px solid transparent;
		border-radius: 8px;
		background: transparent;
		color: rgb(var(--gray-dark));
		text-align: left;
		cursor: pointer;
	}
	:global(.theme-option:hover),
	:global(.theme-option.is-selected) {
		background: rgba(var(--accent), 0.1);
		border-color: rgba(var(--accent), 0.32);
	}
	:global(.theme-option strong),
	:global(.theme-option small) {
		display: block;
	}
	:global(.theme-option strong) {
		font-size: 0.86rem;
		line-height: 1.2;
	}
	:global(.theme-option small) {
		margin-top: 0.12rem;
		color: rgba(var(--gray), 0.82);
		font-size: 0.72rem;
		line-height: 1.25;
	}
	:global(.theme-option-swatch) {
		width: 18px;
		height: 18px;
	}
	:global(.swatch-night) {
		background: linear-gradient(135deg, #7ed6ff, #896eff);
	}
	:global(.swatch-crt) {
		background: linear-gradient(135deg, #f0b35a, #7fe07a);
	}
	:global(.swatch-racing) {
		background: linear-gradient(135deg, #26e0c2, #ff7a2f);
	}
	:global(.swatch-alpine) {
		background: linear-gradient(135deg, #f7f8f2 0 38%, #198fd8 38% 72%, #f27135 72%);
	}
	@keyframes theme-menu-in {
		from {
			opacity: 0;
			transform: translateY(-6px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}
	@media (max-width: 720px) {
		header {
			padding: 0 0.6rem;
		}
		.brand em {
			display: none;
		}
		.internal-links {
			gap: 0.2rem;
		}
		nav a {
			padding: 0.45rem 0.6rem;
		}
		.social-links {
			display: none;
		}
	}
</style>
