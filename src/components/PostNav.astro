---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	prev: CollectionEntry<'blog'> | null;
	next: CollectionEntry<'blog'> | null;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
<nav class="post-nav">
	{prev && (
		<a href={`/blog/${prev.id.replace(/\.md$/, '')}`} class="post-nav-card prev">
			<span class="post-nav-label">← 上一篇</span>
			<span class="post-nav-title">{prev.data.title}</span>
			<span class="post-nav-date"><FormattedDate date={prev.data.pubDate} /></span>
		</a>
	)}
	{next && (
		<a href={`/blog/${next.id.replace(/\.md$/, '')}`} class="post-nav-card next">
			<span class="post-nav-label">下一篇 →</span>
			<span class="post-nav-title">{next.data.title}</span>
			<span class="post-nav-date"><FormattedDate date={next.data.pubDate} /></span>
		</a>
	)}
</nav>
)}

<style>
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		width: min(720px, calc(100% - 2rem));
		margin: 4rem auto 0;
		border-block: 1px solid rgba(var(--border), 0.38);
	}
	.post-nav-card {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.4rem 0;
		background: transparent;
		border: 0;
		border-right: 1px solid rgba(var(--border), 0.38);
		border-radius: 0;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}
	.post-nav-card:hover {
		background: rgba(var(--accent), 0.05);
	}
	.post-nav-card.next {
		padding-left: 1.4rem;
		border-right: 0;
		text-align: right;
	}
	.post-nav-label {
		font-size: 0.78rem;
		color: rgb(var(--accent));
		letter-spacing: 0.04em;
	}
	.post-nav-title {
		font-size: 1.05rem;
		font-weight: 600;
		color: rgb(var(--gray-dark));
		line-height: 1.3;
	}
	.post-nav-date {
		font-size: 0.78rem;
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		.post-nav {
			grid-template-columns: 1fr;
		}
		.post-nav-card { border-right: 0; border-bottom: 1px solid rgba(var(--border), 0.38); }
		.post-nav-card.next { padding-left: 0; border-bottom: 0; }
	}
</style>
