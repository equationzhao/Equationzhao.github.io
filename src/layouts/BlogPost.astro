---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostNav from '../components/PostNav.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	prev?: CollectionEntry<'blog'> | null;
	next?: CollectionEntry<'blog'> | null;
	minutesRead?: string;
};

const { title, description, pubDate, updatedDate, heroImage, prev = null, next = null, minutesRead } = Astro.props;
const pubDateObj = pubDate instanceof Date ? pubDate : new Date(pubDate);
const updatedDateObj = updatedDate ? (updatedDate instanceof Date ? updatedDate : new Date(updatedDate)) : undefined;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": title,
			"description": description,
			"datePublished": pubDateObj.toISOString(),
			...(updatedDateObj && { "dateModified": updatedDateObj.toISOString() }),
			...(heroImage && { "image": new URL(heroImage, Astro.site).href }),
			"author": { "@type": "Person", "name": "Equationzhao" },
			"publisher": { "@type": "Person", "name": "Equationzhao" },
			"url": Astro.url.href,
			"mainEntityOfPage": { "@type": "WebPage", "@id": Astro.url.href }
		})} />
		<style>
			main {
				width: min(1160px, calc(100% - 2.5rem));
				margin: 0 auto;
			}
			.article-header {
				max-width: 920px;
				padding: clamp(1rem, 4vw, 4rem) 0 clamp(2rem, 5vw, 4rem);
			}
			.article-header h1 {
				max-width: 18ch;
				margin: 0;
				font-size: clamp(2.6rem, 7vw, 5.6rem);
				line-height: 1.03;
				letter-spacing: -0.06em;
			}
			.article-description {
				max-width: 58ch;
				margin: 1.2rem 0 0;
				color: rgb(var(--gray));
				font-size: clamp(1rem, 1.8vw, 1.18rem);
			}
			.article-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem 1rem;
				margin-bottom: 1.1rem;
				color: rgb(var(--gray));
				font: 500 0.72rem var(--font-mono);
			}
			.hero-image {
				width: 100%;
				background: rgb(var(--surface-1));
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-height: 680px;
				margin: 0 auto;
				border-radius: 0;
				object-fit: contain;
			}
			.prose {
				width: min(720px, calc(100% - 2rem));
				margin: clamp(2.5rem, 7vw, 5rem) auto 0;
				padding: 0;
			}
			.last-updated-on {
				display: inline;
			}
			@media (max-width: 720px) {
				main {
					width: min(1160px, calc(100% - 1.5rem));
				}
				.prose {
					width: 100%;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="article-header">
					<div class="article-meta">
						<FormattedDate date={pubDateObj} />
						{minutesRead && <span>{minutesRead}</span>}
						{updatedDateObj && <span class="last-updated-on">Updated <FormattedDate date={updatedDateObj} /></span>}
					</div>
					<h1>{title}</h1>
					<p class="article-description">{description}</p>
				</header>
				<div class="hero-image">
					{heroImage && <img width={510} height={205} src={heroImage} alt={title} loading="eager" fetchpriority="high" />}
				</div>
				<div class="prose">
					<slot />
				</div>
				<PostNav prev={prev} next={next} />
			</article>
		</main>
		<Footer />
		<script src="/copy-code.js" defer></script>
		<script src="/lightbox.js" defer></script>
		<script src="/toc.js" defer></script>
	</body>
</html>
