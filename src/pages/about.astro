---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!DOCTYPE html>
<html lang="zh-CN">

<head>
	<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" defer></script>
	<style>
		.about-header {
			display: flex;
			align-items: center;
			gap: 1.2rem;
			margin-bottom: 1.2rem;
		}
		.avatar {
			width: 80px;
			height: 80px;
			border-radius: 50%;
			border: 2px solid rgba(var(--accent), 0.4);
		}
		.about-header-text h1 {
			font-size: clamp(1.4rem, 3vw, 1.8rem);
			margin: 0;
			color: rgb(var(--gray-dark));
		}
		.about-header-text p {
			margin: 0.2rem 0 0;
			font-size: 0.88rem;
			color: rgba(var(--gray), 0.8);
		}
		.about-meta {
			list-style: none;
			padding: 0;
			margin: 0 0 1.2rem;
			display: flex;
			flex-wrap: wrap;
			gap: 0.45rem;
		}
		.about-meta li {
			padding: 0.3rem 0.65rem;
			border-radius: 999px;
			border: 1px solid rgba(var(--border), 0.22);
			background: rgba(var(--surface-0), 0.5);
			font-size: 0.85rem;
			color: rgba(var(--gray), 0.85);
		}

		/* Rendered README */
		.readme-panel {
			padding: 1.8rem 2rem;
			background: rgba(var(--surface-1), 0.72);
			border: 1px solid rgba(var(--border), 0.28);
			border-radius: var(--radius-lg);
			box-shadow: var(--surface-shadow);
			min-height: 120px;
			position: relative;
		}
		.readme-loading {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.6rem;
			padding: 2rem;
			color: rgba(var(--gray-light), 0.6);
			font-size: 0.88rem;
		}
		.readme-loading .spinner {
			width: 18px; height: 18px;
			border: 2px solid rgba(var(--border), 0.3);
			border-top-color: var(--accent);
			border-radius: 50%;
			animation: spin 0.7s linear infinite;
		}
		@keyframes spin { to { transform: rotate(360deg); } }

		.readme-panel h1,
		.readme-panel h2,
		.readme-panel h3,
		.readme-panel h4 {
			color: rgb(var(--gray-dark));
			margin-top: 1.6rem;
			margin-bottom: 0.6rem;
		}
		.readme-panel h1 { font-size: 1.5rem; }
		.readme-panel h2 {
			font-size: 1.2rem;
			padding-bottom: 0.4rem;
			border-bottom: 1px solid rgba(var(--border), 0.15);
		}
		.readme-panel h3 { font-size: 1.05rem; }
		.readme-panel p {
			color: rgba(var(--gray), 0.9);
			line-height: 1.7;
		}
		.readme-panel a {
			color: var(--accent);
			text-decoration: none;
		}
		.readme-panel a:hover { text-decoration: underline; }
		.readme-panel ul, .readme-panel ol {
			padding-left: 1.5rem;
			color: rgba(var(--gray), 0.9);
		}
		.readme-panel li {
			margin-bottom: 0.3rem;
			line-height: 1.7;
		}
		.readme-panel img {
			max-width: 100%;
			border-radius: var(--radius-md);
			margin: 0.6rem 0;
		}
		.readme-panel table {
			width: 100%;
			border-collapse: collapse;
			margin: 0.8rem 0;
			font-size: 0.88rem;
		}
		.readme-panel th {
			text-align: left;
			padding: 0.45rem 0.7rem;
			border-bottom: 2px solid rgba(var(--border), 0.25);
			color: rgb(var(--gray-dark));
			font-weight: 600;
		}
		.readme-panel td {
			padding: 0.4rem 0.7rem;
			border-bottom: 1px solid rgba(var(--border), 0.1);
			color: rgba(var(--gray), 0.85);
		}
		.readme-panel tr:hover td {
			background: rgba(var(--surface-0), 0.3);
		}
		.readme-panel blockquote {
			margin: 0.6rem 0;
			padding: 0.5rem 1rem;
			border-left: 3px solid var(--accent);
			background: rgba(var(--surface-0), 0.3);
			border-radius: 0 var(--radius-md) var(--radius-md) 0;
			color: rgba(var(--gray), 0.8);
		}
		.readme-panel code {
			padding: 0.15rem 0.4rem;
			background: rgba(var(--surface-0), 0.6);
			border-radius: 4px;
			font-size: 0.88em;
			color: rgb(var(--gray-dark));
		}
		.readme-panel pre {
			padding: 1rem;
			background: rgba(var(--surface-0), 0.7);
			border: 1px solid rgba(var(--border), 0.15);
			border-radius: var(--radius-md);
			overflow-x: auto;
		}
		.readme-panel pre code {
			padding: 0;
			background: none;
		}
		.readme-panel hr {
			border: none;
			border-top: 1px solid rgba(var(--border), 0.15);
			margin: 1.5rem 0;
		}

		.readme-source {
			text-align: right;
			margin-top: 1rem;
			font-size: 0.78rem;
		}
		.readme-source a {
			color: rgba(var(--gray-light), 0.7);
		}
		.readme-source a:hover {
			color: var(--accent);
		}
	</style>
	<style>
		.about-intro { max-width: 820px; margin-bottom: 3rem; }
		.about-intro > p:last-child { max-width: 52ch; margin: 1rem 0 0; color: rgb(var(--gray)); }
		.about-header { align-items: center; margin-bottom: 1rem; }
		.avatar { width: 88px; height: 88px; border: 1px solid rgba(var(--border), .42); border-radius: 50%; }
		.about-header-text h1 { font-size: clamp(2.2rem, 6vw, 4rem); color: rgb(var(--gray-dark)); letter-spacing: -.055em; }
		.about-header-text p { color: rgb(var(--gray)); }
		.about-meta { gap: .5rem; margin-bottom: 3rem; }
		.about-meta li { min-height: 32px; padding: .35rem .7rem; border-color: rgba(var(--border), .38); background: transparent; color: rgb(var(--gray)); font: 500 .72rem var(--font-mono); }
		.readme-panel { min-height: 160px; padding: clamp(1.2rem, 4vw, 2.5rem) 0; border: 0; border-block: 1px solid rgba(var(--border), .38); border-radius: 0; background: transparent; box-shadow: none; }
		.readme-loading { color: rgb(var(--gray)); }
		.readme-panel h1, .readme-panel h2, .readme-panel h3, .readme-panel h4 { color: rgb(var(--gray-dark)); }
		.readme-panel p, .readme-panel ul, .readme-panel ol, .readme-panel td { color: rgb(var(--gray)); }
		.readme-panel pre { background: rgb(var(--surface-1)); }
		.readme-error { margin: 0; color: rgb(var(--gray)); }
		.readme-error a { color: rgb(var(--accent)); }
		.readme-source { text-align: left; font-family: var(--font-mono); }
	</style>
</head>

<body>
	<Header />
	<main>
		<div class="about-intro">
			<p class="eyebrow">About</p>
			<div class="about-header">
				<img class="avatar" src="https://avatars.githubusercontent.com/u/75521101?v=4" alt="Equationzhao" />
				<div class="about-header-text">
					<h1>Equationzhao</h1>
					<p>好的方程列出来有诗の美感</p>
				</div>
			</div>
			<p>Engineer by trade, amateur cyclist by choice. This page follows the longer version maintained on GitHub.</p>
		</div>

		<ul class="about-meta">
			<li>Go / C++</li>
			<li>Amateur Cyclist</li>
			<li>USTB</li>
			<li>Arch / macOS</li>
			<li>Shanghai & Hong Kong</li>
		</ul>

		<div class="readme-panel" id="readmeContent">
			<div class="readme-loading"><div class="spinner"></div> Loading from GitHub...</div>
		</div>

		<p class="readme-source">
			Source: <a href="https://github.com/Equationzhao/Equationzhao" target="_blank" rel="noopener noreferrer">github.com/Equationzhao/Equationzhao</a>
		</p>
	</main>
	<Footer />

	<script is:inline>
	(function () {
		const RAW_URL = 'https://raw.githubusercontent.com/Equationzhao/Equationzhao/main/README.md';
		const REPO_BASE = 'https://raw.githubusercontent.com/Equationzhao/Equationzhao/main/';
		const container = document.getElementById('readmeContent');

		function waitForMarked(cb) {
			if (typeof marked !== 'undefined') { cb(); return; }
			setTimeout(function () { waitForMarked(cb); }, 100);
		}

		fetch(RAW_URL)
			.then(function (r) {
				if (!r.ok) throw new Error('HTTP ' + r.status);
				return r.text();
			})
			.then(function (md) {
				// Convert relative image paths to absolute
				md = md.replace(/!\[([^\]]*)\]\((?!https?:\/\/)([^)]+)\)/g, function (alt, _, src) {
					return '![' + alt + '](' + REPO_BASE + src + ')';
				});

				waitForMarked(function () {
					container.innerHTML = marked.parse(md);
				});
			})
			.catch(function (err) {
				container.innerHTML = '<p class="readme-error">GitHub README 暂时无法加载（' + err.message + '）。你仍可以在 <a href="https://github.com/Equationzhao/Equationzhao" target="_blank" rel="noopener noreferrer">GitHub 查看原文</a>。</p>';
			});
	})();
	</script>
</body>

</html>
