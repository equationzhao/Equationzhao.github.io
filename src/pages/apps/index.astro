---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { apps } from '../../data/apps';
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head><BaseHead title={`Tools | ${SITE_TITLE}`} description="Eq 的小工具合集" /></head>
	<body>
		<Header />
		<main>
			<header class="tools-hero">
				<p class="eyebrow">Tools</p>
				<h1>Small instruments<br />for real questions.</h1>
				<p>骑行模型、功率计算，以及一些因为自己需要而做出来的工具。</p>
			</header>
			<section class="app-list" aria-label="Tools">
				{apps.map((app, index) => (
					<a href={app.href} rel={app.external ? 'noopener noreferrer' : 'prefetch-intent'} target={app.external ? '_blank' : undefined}>
						<span class="app-index">{String(index + 1).padStart(2, '0')}</span>
						<span class="app-icon" aria-hidden="true">{app.icon}</span>
						<span class="app-copy"><strong>{app.title}</strong><small>{app.description}</small></span>
						<span class="app-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tools-hero { max-width: 900px; padding: clamp(2rem, 6vw, 5rem) 0 clamp(4rem, 9vw, 8rem); }
	.tools-hero h1 { margin: 0; font-size: clamp(3rem, 8vw, 6.4rem); line-height: .98; letter-spacing: -.065em; }
	.tools-hero > p:last-child { max-width: 48ch; margin: 1.5rem 0 0; color: rgb(var(--gray)); }
	.app-list { border-top: 1px solid rgba(var(--border), .38); }
	.app-list a { display: grid; grid-template-columns: 50px 44px minmax(0, 1fr) auto; gap: 1rem; align-items: start; min-height: 118px; padding: 1.35rem 0; border-bottom: 1px solid rgba(var(--border), .32); color: inherit; text-decoration: none; }
	.app-list a:hover { background: rgba(var(--accent), .05); }
	.app-index { color: rgb(var(--gray)); font: 500 .7rem var(--font-mono); }
	.app-icon { font-size: 1.35rem; }
	.app-copy strong, .app-copy small { display: block; }
	.app-copy strong { font: 650 clamp(1.25rem, 3vw, 1.8rem) var(--font-display); letter-spacing: -.03em; }
	.app-copy small { max-width: 68ch; margin-top: .45rem; color: rgb(var(--gray)); font-size: .86rem; line-height: 1.5; }
	.app-arrow { color: rgb(var(--accent)); font-size: 1.25rem; }
	@media (max-width: 560px) {
		.app-list a { grid-template-columns: 32px 32px minmax(0, 1fr) auto; gap: .65rem; }
	}
</style>
