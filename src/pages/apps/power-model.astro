---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`CP Pro | ${SITE_TITLE}`} description="Deterministic Morton 3-parameter critical power model with fit-stability intervals" />
		<script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<style is:inline>
			/* ---- Reset form elements ---- */
			input[type="number"],
			input[type="checkbox"],
			button {
				all: unset;
				box-sizing: border-box;
			}

			/* ---- Custom number input ---- */
			input[type="number"] {
				display: block;
				width: 100%;
				padding: 0.55rem 0.75rem;
				border: 1px solid rgba(var(--border), 0.3);
				background: rgba(var(--surface-0), 0.55);
				border-radius: 8px;
				font: 400 0.9rem 'DM Mono', monospace;
				color: rgb(var(--gray-dark));
				transition: border-color 0.2s, box-shadow 0.2s;
				-webkit-appearance: none;
				-moz-appearance: textfield;
			}
			input[type="number"]::-webkit-inner-spin-button,
			input[type="number"]::-webkit-outer-spin-button {
				-webkit-appearance: none;
				margin: 0;
			}
			input[type="number"]:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: 0 0 0 3px rgba(var(--accent), 0.12);
			}
			input[type="number"]::placeholder {
				color: rgba(var(--gray-light), 0.4);
			}
			input[type="number"].error {
				border-color: #e74c3c;
				box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.1);
			}

			/* ---- Checkbox ---- */
			input[type="checkbox"] {
				-webkit-appearance: none;
				appearance: none;
				width: 18px;
				height: 18px;
				min-width: 18px;
				border: 2px solid rgba(var(--border), 0.4);
				border-radius: 4px;
				background: rgba(var(--surface-0), 0.5);
				cursor: pointer;
				position: relative;
				transition: all 0.15s;
			}
			input[type="checkbox"]:checked {
				background: var(--accent-strong);
				border-color: var(--accent-strong);
			}
			input[type="checkbox"]:checked::after {
				content: '';
				position: absolute;
				left: 4px;
				top: 1px;
				width: 5px;
				height: 9px;
				border: solid #fff;
				border-width: 0 2px 2px 0;
				transform: rotate(45deg);
			}
			input[type="checkbox"]:focus-visible {
				box-shadow: 0 0 0 3px rgba(var(--accent), 0.2);
			}

			/* ---- Buttons ---- */
			button {
				cursor: pointer;
			}

			/* ---- Layout ---- */
			.pm-top {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.2rem;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				color: var(--accent);
				text-decoration: none;
				font: 500 0.85rem 'Instrument Sans', sans-serif;
			}
			.back-link:hover { opacity: 0.75; }
			.pm-badge {
				font: 500 0.7rem 'DM Mono', monospace;
				color: rgba(var(--gray-light), 0.7);
				padding: 0.25rem 0.7rem;
				border: 1px solid rgba(var(--border), 0.2);
				border-radius: 999px;
				letter-spacing: 0.04em;
			}

			/* ---- Hero metrics ---- */
			.hero-metrics {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 0.8rem;
				margin-bottom: 1.2rem;
				opacity: 0;
				transform: translateY(8px);
				transition: opacity 0.5s ease, transform 0.5s ease;
			}
			.hero-metrics.visible { opacity: 1; transform: translateY(0); }
			.metric-card {
				padding: 1rem 1.2rem;
				background: rgba(var(--surface-1), 0.72);
				border: 1px solid rgba(var(--border), 0.28);
				border-radius: var(--radius-md);
				text-align: center;
				position: relative;
				overflow: hidden;
			}
			.metric-card::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 2px;
				background: var(--accent);
				opacity: 0.5;
			}
			.metric-label {
				font: 500 0.68rem 'DM Mono', monospace;
				color: rgba(var(--gray-light), 0.8);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 0.4rem;
			}
			.metric-value {
				font: 500 clamp(1.3rem, 2.8vw, 1.9rem) 'DM Mono', monospace;
				color: rgb(var(--gray-dark));
				line-height: 1.1;
			}
			.metric-unit {
				font: 400 0.72rem 'DM Mono', monospace;
				color: rgba(var(--gray), 0.6);
				margin-top: 0.25rem;
			}
			.metric-interval {
				min-height: 1rem;
				margin-top: 0.3rem;
				font: 400 0.62rem 'DM Mono', monospace;
				color: rgba(var(--gray-light), 0.62);
			}

			/* ---- Grid ---- */
			.pm-grid {
				display: grid;
				grid-template-columns: 340px 1fr;
				gap: 1rem;
				align-items: start;
			}

			/* ---- Panel ---- */
			.panel {
				padding: 1.2rem;
				background: rgba(var(--surface-1), 0.72);
				border: 1px solid rgba(var(--border), 0.28);
				border-radius: var(--radius-lg);
				box-shadow: var(--surface-shadow);
			}
			.panel-title {
				font: 600 0.78rem 'DM Mono', monospace;
				color: rgba(var(--gray-light), 0.8);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin: 0 0 1rem;
				padding-bottom: 0.6rem;
				border-bottom: 1px solid rgba(var(--border), 0.15);
			}

			/* ---- Form fields ---- */
			.form-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.6rem;
				margin-bottom: 0.7rem;
			}
			.field label {
				display: block;
				font: 500 0.75rem 'Instrument Sans', sans-serif;
				color: rgba(var(--gray), 0.8);
				margin-bottom: 0.3rem;
			}
			.hint-text {
				font: 400 0.65rem 'Instrument Sans', sans-serif;
				color: rgba(var(--gray-light), 0.55);
				margin-top: 0.2rem;
			}

			/* ---- Toggle ---- */
			.toggle-row {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				margin-bottom: 0.8rem;
				padding: 0.55rem 0.7rem;
				border-radius: 8px;
				border: 1px solid rgba(var(--border), 0.18);
				background: rgba(var(--surface-0), 0.3);
			}
			.toggle-row span {
				font: 400 0.82rem 'Instrument Sans', sans-serif;
				color: rgba(var(--gray), 0.85);
			}

			/* ---- Data points ---- */
			.dp-header {
				font: 500 0.75rem 'Instrument Sans', sans-serif;
				color: rgba(var(--gray), 0.75);
				margin-bottom: 0.5rem;
			}
			.point-row {
				display: grid;
				grid-template-columns: 1fr 1fr 30px;
				gap: 0.4rem;
				margin-bottom: 0.35rem;
			}
			.rm-btn {
				width: 30px;
				height: 30px;
				border: none;
				background: transparent;
				color: rgba(var(--gray-light), 0.5);
				border-radius: 6px;
				font-size: 1.1rem;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: all 0.15s;
				align-self: end;
				margin-bottom: 1px;
			}
			.rm-btn:hover { background: rgba(231,76,60,0.1); color: #e74c3c; }
			.rm-btn.off { opacity: 0.2; cursor: default; pointer-events: none; }

			/* ---- Buttons ---- */
			.btn-strip {
				display: flex;
				gap: 0.4rem;
				margin-top: 0.6rem;
			}
			.btn {
				flex: 1;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.55rem 0.8rem;
				border: 1px solid rgba(var(--border), 0.3);
				border-radius: 8px;
				font: 500 0.82rem 'Instrument Sans', sans-serif;
				color: rgb(var(--gray-dark));
				background: rgba(var(--surface-0), 0.4);
				transition: all 0.2s;
			}
			.btn:hover {
				border-color: rgba(var(--accent), 0.5);
				color: var(--accent);
				background: rgba(var(--accent), 0.06);
			}
			.btn-go {
				background: var(--accent-strong);
				color: #fff;
				border-color: transparent;
				font-weight: 600;
			}
			.btn-go:hover { opacity: 0.88; color: #fff; background: var(--accent-strong); }
			.btn-go:disabled { opacity: 0.4; cursor: default; }

			/* ---- Chart ---- */
			.chart-wrap {
				position: relative;
				height: 340px;
			}
			.chart-wrap canvas {
				width: 100% !important;
				height: 100% !important;
			}
			.chart-empty {
				display: flex;
				align-items: center;
				justify-content: center;
				height: 100%;
				font: 400 0.85rem 'Instrument Sans', sans-serif;
				color: rgba(var(--gray-light), 0.45);
			}
			.chart-footer {
				display: flex;
				justify-content: flex-end;
				gap: 0.4rem;
				margin-top: 0.6rem;
			}

			/* ---- Zone bars ---- */
			.zone-row {
				display: grid;
				grid-template-columns: 72px 1fr 80px;
				gap: 0.5rem;
				align-items: center;
				margin-bottom: 0.3rem;
				padding: 0.2rem 0;
			}
			.zone-name {
				font: 400 0.75rem 'Instrument Sans', sans-serif;
				color: rgba(var(--gray), 0.75);
				text-align: right;
			}
			.zone-bar-track {
				height: 8px;
				background: rgba(var(--surface-0), 0.6);
				border-radius: 4px;
				position: relative;
				overflow: hidden;
			}
			.zone-bar-fill {
				position: absolute;
				top: 0;
				height: 100%;
				border-radius: 4px;
			}
			.zone-range {
				font: 400 0.72rem 'DM Mono', monospace;
				color: rgba(var(--gray-light), 0.65);
			}
			.zone-disclaimer {
				margin: -0.35rem 0 0.8rem;
				font: 400 0.7rem/1.45 'Instrument Sans', sans-serif;
				color: rgba(var(--gray-light), 0.62);
			}
			.fit-note {
				margin: 0.75rem 0;
				font: 400 0.7rem/1.5 'Instrument Sans', sans-serif;
				color: rgba(var(--gray-light), 0.68);
			}
			.confidence-note {
				margin-bottom: 0.8rem;
				padding: 0.65rem 0.75rem;
				border: 1px solid rgba(var(--border), 0.18);
				border-radius: 8px;
				font: 400 0.75rem/1.45 'Instrument Sans', sans-serif;
				color: rgba(var(--gray), 0.82);
				background: rgba(var(--surface-0), 0.32);
			}
			.confidence-note.ok { border-color: rgba(46, 204, 113, 0.28); }
			.confidence-note.low { border-color: rgba(241, 196, 15, 0.38); }
			.confidence-note strong { color: rgb(var(--gray-dark)); }

			/* ---- Stats ---- */
			.stats-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.2rem 1rem;
			}
			.stat-item {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				padding: 0.35rem 0;
				border-bottom: 1px solid rgba(var(--border), 0.08);
			}
			.stat-label {
				font: 400 0.8rem 'Instrument Sans', sans-serif;
				color: rgba(var(--gray), 0.7);
			}
			.stat-value {
				font: 500 0.9rem 'DM Mono', monospace;
				color: rgb(var(--gray-dark));
			}
			.stat-unit {
				font: 400 0.7rem 'DM Mono', monospace;
				color: rgba(var(--gray), 0.5);
				margin-left: 0.2rem;
			}

			/* ---- Tooltip ---- */
			[data-tip] {
				position: relative;
				cursor: help;
			}
			[data-tip]::after {
				content: attr(data-tip);
				position: absolute;
				bottom: calc(100% + 8px);
				left: 50%;
				transform: translateX(-50%) translateY(4px);
				width: max-content;
				max-width: 240px;
				padding: 0.5rem 0.7rem;
				background: rgba(var(--surface-2), 0.96);
				border: 1px solid rgba(var(--border), 0.25);
				border-radius: 8px;
				font: 400 0.75rem/1.5 'Instrument Sans', sans-serif;
				color: rgb(var(--gray-dark));
				white-space: normal;
				text-align: center;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.15s, transform 0.15s;
				z-index: 30;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
			}
			[data-tip]:hover::after {
				opacity: 1;
				transform: translateX(-50%) translateY(0);
			}

			/* ---- Empty state ---- */
			.empty-state {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 2.5rem 1rem;
				text-align: center;
			}
			.empty-icon { font-size: 2rem; margin-bottom: 0.6rem; opacity: 0.35; }
			.empty-text { font: 400 0.85rem 'Instrument Sans', sans-serif; color: rgba(var(--gray-light), 0.7); }
			.empty-hint { font: 400 0.75rem 'Instrument Sans', sans-serif; color: rgba(var(--gray-light), 0.4); margin-top: 0.25rem; }

			/* ---- Loading ---- */
			.loading-overlay {
				position: absolute;
				inset: 0;
				background: rgba(var(--surface-0), 0.85);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				border-radius: var(--radius-lg);
				z-index: 5;
			}
			.spinner {
				width: 30px; height: 30px;
				border: 2.5px solid rgba(var(--border), 0.35);
				border-top-color: var(--accent);
				border-radius: 50%;
				animation: spin 0.7s linear infinite;
			}
			@keyframes spin { to { transform: rotate(360deg); } }
			.loading-text {
				margin-top: 0.5rem;
				font: 500 0.78rem 'DM Mono', monospace;
				color: rgba(var(--gray), 0.7);
			}

			@media (max-width: 860px) {
				.pm-grid { grid-template-columns: 1fr; }
				.hero-metrics { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 480px) {
				.hero-metrics { gap: 0.5rem; }
				.metric-card { padding: 0.7rem 0.8rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="pm-top">
				<a class="back-link" href="/apps" rel="prefetch-intent">&larr; Apps</a>
				<span class="pm-badge">Morton 3-param &middot; Deterministic fit</span>
			</div>

			<div class="hero-metrics" id="heroMetrics">
				<div class="metric-card"><div class="metric-label" data-tip="Power-duration asymptote and approximate heavy-to-severe intensity boundary">CP</div><div class="metric-value" id="hCP">--</div><div class="metric-unit">Watts</div><div class="metric-interval" id="hCPi"></div></div>
				<div class="metric-card"><div class="metric-label" data-tip="Model-estimated finite work capacity available above CP">W'</div><div class="metric-value" id="hW">--</div><div class="metric-unit">Joules</div><div class="metric-interval" id="hWi"></div></div>
				<div class="metric-card"><div class="metric-label" data-tip="Model t=0 power intercept; not necessarily observed sprint peak power">Pmax</div><div class="metric-value" id="hPmax">--</div><div class="metric-unit">Watts</div><div class="metric-interval" id="hPmaxi"></div></div>
				<div class="metric-card"><div class="metric-label" data-tip="Rough road-cycling estimate; requires a maximal 4–6 minute anchor and body weight">VO2max est.</div><div class="metric-value" id="hVO2">--</div><div class="metric-unit" id="hVO2u">ml/kg/min</div><div class="metric-interval" id="hVO2i"></div></div>
			</div>

			<div class="pm-grid">
				<!-- Left: Input -->
				<div class="panel">
					<div class="panel-title">Input</div>

					<div class="form-row" style="grid-template-columns:1fr">
						<div class="field">
							<label for="weight">Weight (kg)</label>
							<input type="number" id="weight" step="0.1" placeholder="optional" />
							<div class="hint-text">For VO2max</div>
						</div>
					</div>

					<div class="toggle-row">
						<input type="checkbox" id="outlierDetect" checked />
						<span>Outlier detection</span>
					</div>
					<div class="fit-note">All accepted points are fitted by MSRE. Deterministic means the same inputs return the same best fit—not that every point lies on the curve or that the parameters are certain.</div>

					<div class="dp-header">Power-Time Points</div>
					<div id="pointsContainer"></div>

					<div class="btn-strip">
						<button type="button" id="addPoint" class="btn">+ Add</button>
						<button type="button" id="useExample" class="btn">Example</button>
					</div>
					<div class="btn-strip" style="margin-top:0.6rem">
						<button type="button" id="calculate" class="btn btn-go">Calculate</button>
						<button type="button" id="resetBtn" class="btn" style="flex:0 0 auto;padding:0.55rem 0.9rem">Reset</button>
					</div>
				</div>

				<!-- Right: Results -->
				<div style="display:flex;flex-direction:column;gap:1rem">
					<div class="panel" id="chartPanel">
						<div class="panel-title">Power Curve</div>
						<div class="chart-wrap">
							<div class="chart-empty" id="chartEmpty">Calculate to see power curve</div>
							<canvas id="powerChart" style="display:none"></canvas>
						</div>
						<div class="chart-footer" id="chartFooter" style="display:none">
							<button type="button" class="btn" id="downloadPng" style="flex:0 0 auto">Download PNG</button>
						</div>
					</div>

					<div class="panel" id="zonesPanel">
						<div class="panel-title">CP-relative Training Zones &middot; Approximation</div>
						<div class="zone-disclaimer">Coggan-style percentages applied to model CP for convenience. These are not FTP or laboratory threshold zones.</div>
						<div id="zonesContent">
							<div class="chart-empty" style="height:100px">Waiting for model</div>
						</div>
					</div>

					<div class="panel" id="statsPanel" style="position:relative">
						<div class="panel-title">Details</div>
						<div id="statsContent">
							<div class="empty-state">
								<div class="empty-icon">&#9881;</div>
								<div class="empty-text">Enter data and calculate</div>
								<div class="empty-hint">Need at least 3 power-time points</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<script>
		/* ==== UI ==== */
		const pc=document.getElementById('pointsContainer'),sc=document.getElementById('statsContent'),cb=document.getElementById('calculate');
		let cd=null,ci=null,analysisRevision=0;

		function analyzeInWorker(payload){
			return new Promise((resolve,reject)=>{
				const worker=new Worker(new URL('../../workers/cp-pro-worker.js',import.meta.url),{type:'module'});
				const finish=()=>worker.terminate();
				worker.addEventListener('message',event=>{
					finish();
					if(event.data.ok)resolve(event.data.result);
					else{const error=new Error(event.data.error.message);error.name=event.data.error.name;error.code=event.data.error.code;reject(error);}
				},{once:true});
				worker.addEventListener('error',event=>{finish();reject(new Error(event.message||'CP Pro analysis worker failed.'));},{once:true});
				worker.postMessage(payload);
			});
		}

		function mkRow(){
			const r=document.createElement('div');r.className='point-row';
			r.innerHTML='<input type="number" class="time-input" step="0.1" placeholder="sec" /><input type="number" class="power-input" step="0.1" placeholder="W" /><button type="button" class="rm-btn off">&times;</button>';
			r.querySelector('.rm-btn').addEventListener('click',function(){if(!this.classList.contains('off')){r.remove();updRm();markInputsChanged();save();}});
			return r;
		}
		function addRow(){pc.appendChild(mkRow());updRm();}
		function updRm(){const rs=pc.querySelectorAll('.point-row');rs.forEach(r=>r.querySelector('.rm-btn').classList.toggle('off',rs.length<=3));}

		function save(){
			const pts=[];pc.querySelectorAll('.point-row').forEach(r=>pts.push({time:r.querySelector('.time-input').value,power:r.querySelector('.power-input').value}));
			localStorage.setItem('pmF',JSON.stringify({pts,w:document.getElementById('weight').value,od:document.getElementById('outlierDetect').checked}));
		}
		function load(){
			try{const j=JSON.parse(localStorage.getItem('pmF'));
				if(j){if(j.w)document.getElementById('weight').value=j.w;if(j.od!==undefined)document.getElementById('outlierDetect').checked=j.od;
					if(j.pts&&j.pts.length){pc.innerHTML='';j.pts.forEach(p=>{const r=mkRow();if(p.time)r.querySelector('.time-input').value=p.time;if(p.power)r.querySelector('.power-input').value=p.power;pc.appendChild(r);});updRm();return;}}
			}catch(e){localStorage.removeItem('pmF');}
			for(let i=0;i<3;i++)addRow();
		}

		function collect(){
			const pts=[];let ok=true;
			pc.querySelectorAll('.point-row').forEach(r=>{
				const ti=r.querySelector('.time-input'),pi=r.querySelector('.power-input');
				const t=Number(ti.value),p=Number(pi.value);
				if(!t||t<=0||!p||p<=0){ok=false;ti.classList.add('error');pi.classList.add('error');}
				else{ti.classList.remove('error');pi.classList.remove('error');pts.push({time:t,power:p});}
			});return ok?pts:null;
		}

		function fv(v){return v<10?v.toFixed(2):v<100?v.toFixed(1):v.toFixed(0);}

		function intervalText(interval, formatter=fv){
			return interval?`95% stability: ${formatter(interval[0])}–${formatter(interval[1])}`:'Stability interval unavailable';
		}

		function display(analysis){
			const m=analysis.model;
			const w=Number(document.getElementById('weight').value)||0;
			document.getElementById('heroMetrics').classList.add('visible');
			document.getElementById('hCP').textContent=fv(m.cp);
			document.getElementById('hW').textContent=fv(m.wPrime);
			document.getElementById('hPmax').textContent=fv(m.pMax);
			document.getElementById('hCPi').textContent=intervalText(m.intervals?.cp);
			document.getElementById('hWi').textContent=intervalText(m.intervals?.wPrime);
			document.getElementById('hPmaxi').textContent=intervalText(m.intervals?.pMax);
			document.getElementById('hVO2').textContent=analysis.vo2Estimate?fv(analysis.vo2Estimate):'--';
			document.getElementById('hVO2u').textContent=analysis.vo2Estimate?'ml/kg/min':'not available';
			document.getElementById('hVO2i').textContent=analysis.vo2Estimate?'Estimate from modeled 5-minute power':'Requires a trusted fit, valid weight, and a 240–360s maximal point';

			cd={analysis};
			renderChart();

			const zonesContent=document.getElementById('zonesContent');
			if(!analysis.zones.length){
				zonesContent.innerHTML='<div class="confidence-note low">Zones hidden because the fit is low-confidence. Add at least 6 maximal efforts covering ≤60s, 120–480s, and ≥600s.</div>';
			}else{
				const maxW=m.cp*1.65;
				zonesContent.innerHTML=analysis.zones.map(z=>{
					const left=(z.min/maxW*100).toFixed(1);
					const visualMax=z.max??maxW;
					const width=(Math.max(0,visualMax-z.min)/maxW*100).toFixed(1);
					const range=z.max===null?`>${z.min-1}`:`${z.min}–${z.max}`;
					return `<div class="zone-row"><span class="zone-name" title="${z.label}">${z.name}</span><div class="zone-bar-track"><div class="zone-bar-fill" style="left:${left}%;width:${width}%;background:${z.color}"></div></div><span class="zone-range">${range}</span></div>`;
				}).join('');
			}

			const reasons=analysis.diagnostics.reasons;
			let sh=`<div class="confidence-note ${analysis.diagnostics.status==='ok'?'ok':'low'}"><strong>${analysis.diagnostics.status==='ok'?'Trusted fit':'Low-confidence fit'}</strong>${reasons.length?` · ${reasons.join(' · ')}`:' · Stability checks passed.'}</div><div class="stats-grid">`;
			sh+=`<div class="stat-item"><span class="stat-label" data-tip="Morton model time offset">Tau</span><span><span class="stat-value">${fv(m.tau)}</span><span class="stat-unit">s${m.intervals?` · 95% ${fv(m.intervals.tau[0])}–${fv(m.intervals.tau[1])}`:''}</span></span></div>`;
			sh+=`<div class="stat-item"><span class="stat-label" data-tip="Displayed watt-scale error; optimization uses MSRE">RMSE</span><span><span class="stat-value">${fv(m.rmse)}</span><span class="stat-unit">W</span></span></div>`;
			sh+=`<div class="stat-item"><span class="stat-label" data-tip="Square root of the MSRE objective">Typical relative error</span><span><span class="stat-value">${fv(Math.sqrt(m.msre)*100)}</span><span class="stat-unit">%</span></span></div>`;
			sh+=`<div class="stat-item"><span class="stat-label" data-tip="Mean absolute relative residual">Mean relative error</span><span><span class="stat-value">${fv(m.meanRelativeError*100)}</span><span class="stat-unit">%</span></span></div>`;
			sh+=`<div class="stat-item"><span class="stat-label">Accepted points</span><span><span class="stat-value">${analysis.acceptedPoints.length}</span></span></div>`;
			if(w>0)sh+=`<div class="stat-item"><span class="stat-label" data-tip="CP divided by body mass">CP / weight</span><span><span class="stat-value">${fv(m.cp/w)}</span><span class="stat-unit">W/kg</span></span></div>`;
			if(analysis.outliers.length)sh+=`<div class="stat-item"><span class="stat-label" data-tip="Duplicate-duration or residual outlier points excluded before the final fit">Outliers</span><span><span class="stat-value">${analysis.outliers.length}</span></span></div>`;
			sh+='</div>';sc.innerHTML=sh;
		}

		function clearResults(errorMessage=null){
			document.getElementById('heroMetrics').classList.remove('visible');
			document.getElementById('chartEmpty').style.display='';
			document.getElementById('powerChart').style.display='none';
			document.getElementById('chartFooter').style.display='none';
			document.getElementById('zonesContent').innerHTML='<div class="chart-empty" style="height:100px">Waiting for a trusted model</div>';
			if(ci){ci.destroy();ci=null;}
			cd=null;
			sc.innerHTML='';
			if(errorMessage){
				const error=document.createElement('p');error.style.cssText='color:#e74c3c;font-size:0.85rem';error.textContent=errorMessage;sc.appendChild(error);
			}
		}

		function markInputsChanged(){
			analysisRevision++;
			if(cd)clearResults();
		}

		/* ==== CHART ==== */
		function renderChart(){
			if(!cd||typeof Chart==='undefined'){if(cd)setTimeout(renderChart,100);return;}
			document.getElementById('chartEmpty').style.display='none';
			document.getElementById('powerChart').style.display='block';
			document.getElementById('chartFooter').style.display='flex';
			const ctx=document.getElementById('powerChart').getContext('2d');
			if(ci)ci.destroy();
			const{analysis}=cd;
			const{curve,model:m,acceptedPoints,outliers}=analysis;
			const outlierPoints=outliers.map(outlier=>outlier.point);
			const maxX=Math.max(3600,...curve.best.map(p=>p.time),...acceptedPoints.map(p=>p.time),...outlierPoints.map(p=>p.time));
			const dk=document.documentElement.getAttribute('data-theme')!=='light';
			const gc=dk?'rgba(126,214,255,0.08)':'rgba(0,0,0,0.06)';
			const tc=dk?'rgba(180,200,230,0.7)':'rgba(50,60,80,0.6)';
			const lc=dk?'rgba(126,214,255,0.8)':'rgba(52,152,219,0.85)';
			const band=curve.lower.length&&curve.upper.length?[
				{label:'Stability lower',data:curve.lower.map(p=>({x:p.time,y:p.power})),borderColor:'transparent',backgroundColor:'transparent',showLine:true,pointRadius:0},
				{label:'95% fit stability',data:curve.upper.map(p=>({x:p.time,y:p.power})),borderColor:'transparent',backgroundColor:dk?'rgba(126,214,255,0.13)':'rgba(52,152,219,0.13)',fill:'-1',showLine:true,pointRadius:0},
			]:[];
			ci=new Chart(ctx,{type:'scatter',data:{datasets:[
				...band,
				{label:'Best fit',data:curve.best.map(p=>({x:p.time,y:p.power})),borderColor:lc,backgroundColor:'transparent',borderWidth:2,showLine:true,pointRadius:0},
				{label:`CP ${fv(m.cp)}W`,data:[{x:1,y:m.cp},{x:maxX,y:m.cp}],borderColor:dk?'rgba(200,210,230,0.3)':'rgba(0,0,0,0.2)',borderWidth:1,borderDash:[5,3],showLine:true,pointRadius:0},
				{label:'Accepted data',data:acceptedPoints.map(p=>({x:p.time,y:p.power})),borderColor:'rgba(231,76,60,0.9)',backgroundColor:'rgba(231,76,60,0.7)',showLine:false,pointRadius:5,pointHoverRadius:7,pointStyle:'circle'},
				...(outlierPoints.length?[{label:'Outlier',data:outlierPoints.map(p=>({x:p.time,y:p.power})),borderColor:'rgba(155,89,182,0.9)',backgroundColor:'rgba(155,89,182,0.7)',showLine:false,pointRadius:5,pointStyle:'triangle'}]:[]),
			]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'nearest',intersect:false,axis:'x'},
				plugins:{legend:{display:true,position:'bottom',labels:{color:tc,usePointStyle:true,padding:14,font:{family:"'DM Mono',monospace",size:11}},onClick:null},
					tooltip:{filter:c=>Number.isFinite(c.parsed.y),callbacks:{label:c=>` ${c.dataset.label}: ${c.parsed.y.toFixed(1)}W`}}},
				scales:{
					x:{type:'logarithmic',title:{display:true,text:'Time (s)',color:tc,font:{family:"'DM Mono',monospace",size:12}},max:maxX,ticks:{color:tc,font:{family:"'DM Mono',monospace",size:10},callback:v=>{if([1,5,15].includes(v))return v+'s';if([60,300,600].includes(v))return v/60+'m';if(v===3600)return'1h';if(v===maxX&&maxX>3600)return`${(maxX/3600).toFixed(maxX%3600?1:0)}h`;return'';}},grid:{color:gc}},
					y:{title:{display:true,text:'Power (W)',color:tc,font:{family:"'DM Mono',monospace",size:12}},ticks:{color:tc,font:{family:"'DM Mono',monospace",size:10}},grid:{color:gc}}
				}}});
		}

		document.getElementById('downloadPng').addEventListener('click',()=>{
			if(!ci)return;const a=document.createElement('a');a.download=`power-curve-cp-${cd.analysis.model.cp.toFixed(0)}.png`;a.href=ci.canvas.toDataURL('image/png');a.click();
		});

		/* ==== EVENTS ==== */
		document.getElementById('addPoint').addEventListener('click',()=>{addRow();markInputsChanged();save();});
		document.getElementById('useExample').addEventListener('click',()=>{
			markInputsChanged();
			pc.innerHTML='';
			[{time:5,power:1020},{time:20,power:750},{time:60,power:525},{time:180,power:390},{time:300,power:356.25},{time:600,power:329.03},{time:1200,power:314.75}].forEach(p=>{const r=mkRow();r.querySelector('.time-input').value=p.time;r.querySelector('.power-input').value=p.power;pc.appendChild(r);});
			document.getElementById('weight').value=70;updRm();save();
		});

		pc.addEventListener('input',()=>{markInputsChanged();save();});document.getElementById('weight').addEventListener('input',()=>{markInputsChanged();save();});
		document.getElementById('outlierDetect').addEventListener('change',()=>{markInputsChanged();save();});

		cb.addEventListener('click',async()=>{
			const pts=collect();if(!pts)return;if(pts.length<3){alert('At least 3 points needed');return;}
			const od=document.getElementById('outlierDetect').checked;
			const submittedWeight=Number(document.getElementById('weight').value)||null;
			const requestRevision=++analysisRevision;
			const panel=document.getElementById('statsPanel');
			const ov=document.createElement('div');ov.className='loading-overlay';ov.innerHTML='<div class="spinner"></div><div class="loading-text">Deterministic fit + stability bootstrap...</div>';
			clearResults();
			panel.appendChild(ov);cb.disabled=true;
			try{pts.sort((a,b)=>a.time-b.time);
				const analysis=await analyzeInWorker({points:pts,weightKg:submittedWeight,detectOutliers:od});
				if(requestRevision!==analysisRevision)return;
				display(analysis);save();
			}catch(err){if(requestRevision===analysisRevision)clearResults(err.message);}
			finally{ov.remove();cb.disabled=false;}
		});

		document.getElementById('resetBtn').addEventListener('click',()=>{
			if(!confirm('Reset all data?'))return;
			markInputsChanged();
			pc.innerHTML='';for(let i=0;i<3;i++)addRow();
			document.getElementById('weight').value='';document.getElementById('outlierDetect').checked=true;
			clearResults();
			sc.innerHTML='<div class="empty-state"><div class="empty-icon">&#9881;</div><div class="empty-text">Enter data and calculate</div><div class="empty-hint">Need at least 3 power-time points</div></div>';
			localStorage.removeItem('pmF');
		});

		load();
		</script>
	</body>
</html>
