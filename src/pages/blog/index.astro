---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getBlogPostPath, getPublishedBlogPosts } from '../../lib/blog';

const posts = await getPublishedBlogPosts();
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			section {
				padding: 1.2rem;
				background: rgba(var(--surface-1), 0.72);
				border: 1px solid rgba(var(--border), 0.28);
				border-radius: var(--radius-lg);
				box-shadow: var(--surface-shadow);
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				position: relative;
				overflow: hidden;
				border-radius: var(--radius-md);
				background: rgba(var(--surface-0), 0.55);
				border: 1px solid rgba(var(--border), 0.2);
				box-shadow: 0 8px 24px rgba(3, 7, 18, 0.16);
				transform: translateY(0);
				transition:
					transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1),
					border-color 0.28s ease,
					background 0.28s ease,
					box-shadow 0.32s ease;
			}
			ul li::before {
				content: '';
				position: absolute;
				inset: 0;
				pointer-events: none;
				background:
					radial-gradient(circle at 18% 0%, rgba(var(--accent), 0.16), transparent 34%),
					linear-gradient(135deg, rgba(255, 255, 255, 0.05), transparent 42%);
				opacity: 0;
				transition: opacity 0.32s ease;
			}
			ul li:first-child {
				grid-column: 1 / -1;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				display: block;
				width: 100%;
				aspect-ratio: 510 / 205;
				object-fit: cover;
				border-radius: 12px;
				filter: saturate(0.92) brightness(0.88);
				transform: scale(1.01);
				transition:
					transform 0.42s cubic-bezier(0.2, 0.8, 0.2, 1),
					filter 0.32s ease,
					box-shadow 0.32s ease;
			}
			ul li a {
				position: relative;
				z-index: 1;
				display: block;
				padding: 1rem;
				text-decoration: none;
			}
			.hero-image {
				overflow: hidden;
				margin-bottom: 0.8rem;
				border-radius: 12px;
				background: rgba(var(--surface-2), 0.4);
			}
			.title {
				margin: 0 0 0.5rem;
				color: rgb(237, 242, 255);
				line-height: 1.2;
				transition: color 0.28s ease, transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.description {
				margin: 0 0 0.45rem;
				color: rgb(var(--gray));
				transition: color 0.28s ease;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
				transition: color 0.28s ease;
			}
			ul li:hover,
			ul li:focus-within {
				background: rgba(var(--surface-0), 0.74);
				border-color: rgba(var(--accent), 0.42);
				box-shadow: 0 16px 34px rgba(3, 7, 18, 0.36), 0 0 0 1px rgba(var(--accent), 0.12);
				transform: translateY(-4px);
			}
			ul li:hover::before,
			ul li:focus-within::before {
				opacity: 1;
			}
			ul li:hover .title,
			ul li:focus-within .title {
				color: rgb(var(--accent));
				transform: translateY(-1px);
			}
			ul li:hover .description,
			ul li:focus-within .description {
				color: rgb(var(--gray-dark));
			}
			ul li:hover img,
			ul li:focus-within img {
				filter: saturate(1.05) brightness(1);
				transform: scale(1.035);
				box-shadow: 0 0 0 1px rgba(var(--accent), 0.48), 0 10px 24px rgba(4, 8, 22, 0.55);
			}
			@media (prefers-reduced-motion: reduce) {
				ul li,
				ul li::before,
				ul li img,
				.title,
				.description,
				.date {
					transition: none;
				}
				ul li:hover,
				ul li:focus-within,
				ul li:hover .title,
				ul li:focus-within .title,
				ul li:hover img,
				ul li:focus-within img {
					transform: none;
				}
			}
			@media (max-width: 720px) {
				section {
					padding: 0.8rem;
				}
				ul {
					grid-template-columns: 1fr;
					gap: 0.8rem;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main transition:animate="fade">
			<section>
				<ul>
					{						
						posts.map((post, index) => (
							<li>
								<a href={getBlogPostPath(post.id)} rel = prefetch-intent>
									<div class="hero-image">
										<img width={510} height={205} src={post.data.heroImage} alt={post.data.title} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : undefined} />
									</div>
									<h4 class="title">{post.data.title}</h4>
									<p class="description"><em>{post.data.description}</em></p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
