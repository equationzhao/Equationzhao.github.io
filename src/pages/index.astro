---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { apps } from '../data/apps';
import { getBlogPostPath, getPublishedBlogPosts } from '../lib/blog';
import bikehomeCover from '../assets/home-gallery/bikehome-cover.webp';
import cornerTraining from '../assets/home-gallery/corner-training.webp';
import forestGroup from '../assets/home-gallery/forest-group.webp';
import summitSelfie from '../assets/home-gallery/summit-selfie.webp';
import zhoushanRide from '../assets/home-gallery/zhoushan-ride.webp';

const gallery = [
	{ src: summitSelfie, alt: '骑行者在山顶公路旁与连绵群山自拍', label: 'Climb', title: '山巅之后', position: 'center 56%' },
	{ src: bikehomeCover, alt: '以公路骑行为主题的 Bikehome Momentum 杂志封面', label: 'Cover', title: 'Momentum', position: 'center center' },
	{ src: zhoushanRide, alt: '环舟山骑游大会中正在爬坡的公路车骑行者', label: 'Event', title: '环舟山 2026', position: 'center 63%' },
	{ src: cornerTraining, alt: '穿粉色骑行服的骑行者独自通过山路弯道', label: 'Corners', title: '过弯', position: 'center center' },
	{ src: forestGroup, alt: '三名骑行者沿着潮湿的林间公路向前骑行', label: 'Together', title: '雨林骑行', position: 'center 62%' },
];

const posts = await getPublishedBlogPosts();
const featuredPost = posts[0];
const recentPosts = posts.slice(1, 4);
const featuredTags = featuredPost?.data.tags.slice(0, 3) ?? [];
const featuredPath = featuredPost ? getBlogPostPath(featuredPost.id) : '/blog';
---

<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={summitSelfie.src} />
	</head>
	<body>
		<Header />
		<main>
			<section class="home-hero" aria-labelledby="home-title">
				<div>
					<p class="eyebrow">Eq's personal notebook</p>
					<h1 id="home-title">Build things.<br />Ride far.<br />Notice more.</h1>
				</div>
				<div class="hero-copy">
					<p>关于工程、骑行与那些值得留下来的小事。一个工程师的开放式记录。</p>
					<div class="hero-actions">
						<a class="action action-primary" href="/blog" rel="prefetch-intent">Read latest</a>
						<a class="action" href="/apps" rel="prefetch-intent">Open tools</a>
					</div>
				</div>
			</section>

			<section class="ride-archive" data-ride-gallery aria-labelledby="ride-title">
				<div class="section-heading gallery-heading">
					<div>
						<p class="eyebrow">Ride archive</p>
						<h2 id="ride-title">On the road.</h2>
					</div>
					<p>Five frames from the miles between.</p>
				</div>

				<p class="sr-only" id="gallery-instructions">左右滑动照片，或使用上一张、下一张按钮和键盘方向键。</p>
				<div
					class="gallery-viewport"
					data-gallery-viewport
					tabindex="0"
					role="region"
					aria-roledescription="carousel"
					aria-label="骑行照片轮播"
					aria-describedby="gallery-instructions"
				>
					<div class="gallery-track" data-gallery-track>
						{gallery.map((photo, index) => (
							<figure
								class="gallery-slide"
								data-gallery-slide
								data-index={index}
								data-caption={`${photo.label} / ${photo.title}`}
								role="group"
								aria-roledescription="slide"
								aria-label={`第 ${index + 1} 张，共 ${gallery.length} 张：${photo.title}`}
								aria-hidden={index === 0 ? 'false' : 'true'}
							>
								<div class="photo-stage">
									<Image
										src={photo.src}
										alt={photo.alt}
										widths={[480, 720, 960, 1280, 1600, 2000]}
										sizes="(max-width: 720px) 88vw, min(980px, 78vw)"
										quality={84}
										loading={index === 0 ? 'eager' : 'lazy'}
										fetchpriority={index === 0 ? 'high' : 'auto'}
										style={`--photo-position: ${photo.position}`}
									/>
								</div>
								<figcaption>
									<span>{photo.label}</span>
									<strong>{photo.title}</strong>
								</figcaption>
							</figure>
						))}
					</div>
				</div>

				<div class="gallery-controls">
					<output data-gallery-count aria-live="off">01 / {String(gallery.length).padStart(2, '0')}</output>
					<div class="gallery-progress" aria-hidden="true">
						{gallery.map((_, index) => <span data-gallery-progress class:list={{ active: index === 0 }}></span>)}
					</div>
					<div class="gallery-buttons">
						<button type="button" data-gallery-prev aria-label="上一张照片">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg>
						</button>
						<button type="button" data-gallery-next aria-label="下一张照片">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
						</button>
					</div>
				</div>
				<p class="sr-only" data-gallery-live aria-live="polite">Climb / 山巅之后</p>
			</section>

			<section class="home-section" aria-labelledby="writing-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Writing</p>
						<h2 id="writing-title">From the notebook</h2>
					</div>
					<a href="/blog" rel="prefetch-intent">See all →</a>
				</div>

				{featuredPost && (
					<a class="featured-post" href={featuredPath} rel="prefetch-intent">
						<div class="featured-index" aria-hidden="true">Latest</div>
						<div>
							<div class="post-meta">
								<FormattedDate date={featuredPost.data.pubDate} />
								{featuredTags.map((tag) => <span>{tag}</span>)}
							</div>
							<h3>{featuredPost.data.title}</h3>
							<p>{featuredPost.data.description}</p>
						</div>
						<span class="post-arrow" aria-hidden="true">↗</span>
					</a>
				)}

				<div class="recent-posts">
					{recentPosts.map((post) => (
						<a href={getBlogPostPath(post.id)} rel="prefetch-intent">
							<div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</div>
							<FormattedDate date={post.data.pubDate} />
						</a>
					))}
				</div>
			</section>

			<section class="home-section" aria-labelledby="tools-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Tools</p>
						<h2 id="tools-title">Small instruments</h2>
					</div>
					<a href="/apps" rel="prefetch-intent">All tools →</a>
				</div>
				<div class="tool-list">
					{apps.slice(0, 3).map((app) => (
						<a href={app.href} target={app.external ? '_blank' : undefined} rel={app.external ? 'noopener noreferrer' : 'prefetch-intent'}>
							<span class="tool-icon" aria-hidden="true">{app.icon}</span>
							<span><strong>{app.title}</strong><small>{app.description}</small></span>
							<span aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const initRideGallery = () => {
		const root = document.querySelector<HTMLElement>('[data-ride-gallery]:not([data-ready])');
		if (!root) return;
		root.dataset.ready = 'true';

		const viewport = root.querySelector<HTMLElement>('[data-gallery-viewport]');
		const track = root.querySelector<HTMLElement>('[data-gallery-track]');
		const slides = [...root.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
		const count = root.querySelector<HTMLOutputElement>('[data-gallery-count]');
		const live = root.querySelector<HTMLElement>('[data-gallery-live]');
		const progress = [...root.querySelectorAll<HTMLElement>('[data-gallery-progress]')];
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!viewport || !track || !count || !live || slides.length === 0) return;

		let activeIndex = 0;
		let requestedIndex = 0;

		const setActive = (index: number, announce = false) => {
			activeIndex = Math.max(0, Math.min(slides.length - 1, index));
			requestedIndex = activeIndex;
			slides.forEach((slide, slideIndex) => slide.setAttribute('aria-hidden', String(slideIndex !== activeIndex)));
			progress.forEach((item, itemIndex) => item.classList.toggle('active', itemIndex === activeIndex));
			count.value = `${String(activeIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
			if (announce) live.textContent = slides[activeIndex].dataset.caption ?? '';
		};

		const goTo = (index: number, announce = true) => {
			const wrapped = (index + slides.length) % slides.length;
			requestedIndex = wrapped;
			const left = slides[wrapped].offsetLeft - track.offsetLeft;
			viewport.scrollTo({ left, behavior: reducedMotion ? 'auto' : 'smooth' });
			setActive(wrapped, announce);
		};

		root.querySelector<HTMLButtonElement>('[data-gallery-prev]')?.addEventListener('click', () => goTo(requestedIndex - 1));
		root.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => goTo(requestedIndex + 1));
		viewport.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
			event.preventDefault();
			goTo(requestedIndex + (event.key === 'ArrowRight' ? 1 : -1));
		});

		const observer = new IntersectionObserver((entries) => {
			const visible = entries
				.filter((entry) => entry.isIntersecting)
				.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
			if (!visible) return;
			const index = Number((visible.target as HTMLElement).dataset.index);
			if (Number.isFinite(index) && index !== activeIndex) setActive(index, true);
		}, { root: viewport, threshold: [0.58, 0.72, 0.9] });
		slides.forEach((slide) => observer.observe(slide));

		const resizeObserver = new ResizeObserver(() => {
			viewport.scrollLeft = slides[activeIndex].offsetLeft - track.offsetLeft;
		});
		resizeObserver.observe(viewport);
		setActive(0);

		document.addEventListener('astro:before-swap', () => {
			observer.disconnect();
			resizeObserver.disconnect();
		}, { once: true });
	};

	initRideGallery();
	document.addEventListener('astro:page-load', initRideGallery);
</script>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.7fr);
		gap: clamp(2rem, 8vw, 7rem);
		align-items: end;
		min-height: min(620px, calc(100vh - 68px));
		padding: clamp(3rem, 9vw, 8rem) 0;
		border-bottom: 1px solid rgba(var(--border), 0.38);
	}

	.home-hero h1 {
		max-width: 7ch;
		margin: 0;
		font-size: clamp(3.4rem, 9.2vw, 7.4rem);
		font-weight: 650;
		letter-spacing: -0.075em;
		line-height: 0.92;
	}

	.hero-copy {
		padding-bottom: 0.65rem;
	}

	.hero-copy > p {
		max-width: 30ch;
		margin: 0;
		color: rgb(var(--gray));
		font-size: clamp(1rem, 1.6vw, 1.12rem);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.6rem;
	}

	.action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 1rem;
		border: 1px solid rgba(var(--border), 0.42);
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		font: 600 0.82rem var(--font-display);
		text-decoration: none;
	}

	.action:hover {
		border-color: rgba(var(--accent), 0.65);
		background: rgba(var(--accent), 0.08);
	}

	.action-primary {
		border-color: rgb(var(--gray-dark));
		background: rgb(var(--gray-dark));
		color: rgb(var(--surface-0));
	}

	.action-primary:hover {
		border-color: rgb(var(--accent));
		background: rgb(var(--accent));
		color: rgb(var(--accent-ink));
	}

	.ride-archive {
		padding: clamp(4rem, 9vw, 8rem) 0;
		border-bottom: 1px solid rgba(var(--border), 0.38);
	}

	.gallery-heading > p {
		max-width: 28ch;
		margin: 0 0 0.3rem;
		color: rgb(var(--gray));
		text-align: right;
	}

	.gallery-viewport {
		width: min(1400px, calc(100vw - 2rem));
		margin-left: 50%;
		transform: translateX(-50%);
		overflow-x: auto;
		overscroll-behavior-inline: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		touch-action: pan-x pan-y;
	}

	.gallery-viewport::-webkit-scrollbar {
		display: none;
	}

	.gallery-track {
		display: flex;
		gap: clamp(0.8rem, 2vw, 1.4rem);
		width: max-content;
		padding-right: 11vw;
	}

	.gallery-slide {
		flex: 0 0 min(980px, 78vw);
		width: min(980px, 78vw);
		margin: 0;
		scroll-snap-align: start;
		scroll-snap-stop: always;
	}

	.photo-stage {
		display: grid;
		height: clamp(360px, 55vw, 650px);
		place-items: center;
		overflow: hidden;
		border: 1px solid rgba(var(--border), 0.3);
		background: rgb(var(--surface-1));
	}

	.photo-stage :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: contain;
		object-position: var(--photo-position);
	}

	.gallery-slide figcaption {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		padding: 0.8rem 0 0;
		font-family: var(--font-display);
	}

	.gallery-slide[aria-hidden='true'] figcaption {
		opacity: 0;
	}

	.gallery-slide figcaption span {
		color: rgb(var(--accent));
		font: 650 0.68rem var(--font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.gallery-slide figcaption strong {
		color: rgb(var(--gray-dark));
		font-size: 1rem;
		font-weight: 600;
	}

	.gallery-controls {
		display: grid;
		grid-template-columns: auto minmax(100px, 1fr) auto;
		align-items: center;
		gap: 1rem;
		margin-top: 1.25rem;
	}

	.gallery-controls output {
		min-width: 4.8rem;
		color: rgb(var(--gray));
		font: 600 0.75rem var(--font-mono);
		font-variant-numeric: tabular-nums;
	}

	.gallery-progress {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.35rem;
	}

	.gallery-progress span {
		height: 2px;
		background: rgba(var(--border), 0.38);
	}

	.gallery-progress span.active {
		background: rgb(var(--accent));
	}

	.gallery-buttons {
		display: flex;
		gap: 0.5rem;
	}

	.gallery-buttons button {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		padding: 0;
		border: 1px solid rgba(var(--border), 0.42);
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}

	.gallery-buttons button:hover {
		border-color: rgb(var(--accent));
		background: rgba(var(--accent), 0.08);
	}

	.gallery-buttons svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}

	.home-section {
		padding: clamp(4rem, 9vw, 8rem) 0 0;
	}

	.featured-post {
		display: grid;
		grid-template-columns: minmax(110px, 0.35fr) minmax(0, 1fr) auto;
		gap: clamp(1rem, 4vw, 3rem);
		align-items: start;
		padding: clamp(1.4rem, 4vw, 2.8rem) 0;
		border-top: 1px solid rgba(var(--border), 0.38);
		border-bottom: 1px solid rgba(var(--border), 0.38);
		color: inherit;
		text-decoration: none;
	}

	.featured-index {
		color: rgb(var(--accent));
		font: 650 0.72rem var(--font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.85rem;
		color: rgb(var(--gray));
		font: 500 0.72rem var(--font-mono);
	}

	.featured-post h3 {
		max-width: 18ch;
		margin: 0.8rem 0 0;
		font-size: clamp(1.8rem, 4.4vw, 3.8rem);
		line-height: 1.08;
	}

	.featured-post p {
		max-width: 56ch;
		margin: 1rem 0 0;
		color: rgb(var(--gray));
	}

	.post-arrow {
		color: rgb(var(--accent));
		font-size: 1.5rem;
	}

	.featured-post:hover h3,
	.recent-posts a:hover h3 {
		color: rgb(var(--accent));
	}

	.recent-posts a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: start;
		padding: 1.25rem 0;
		border-bottom: 1px solid rgba(var(--border), 0.3);
		color: inherit;
		text-decoration: none;
	}

	.recent-posts h3 {
		margin: 0;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
	}

	.recent-posts p {
		max-width: 62ch;
		margin: 0.35rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}

	.recent-posts :global(time) {
		color: rgb(var(--gray));
		font: 500 0.72rem var(--font-mono);
		white-space: nowrap;
	}

	.tool-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid rgba(var(--border), 0.38);
		border-bottom: 1px solid rgba(var(--border), 0.38);
	}

	.tool-list a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 0.85rem;
		min-height: 136px;
		padding: 1.2rem;
		border-right: 1px solid rgba(var(--border), 0.38);
		color: inherit;
		text-decoration: none;
	}

	.tool-list a:last-child {
		border-right: 0;
	}

	.tool-list a:hover {
		background: rgba(var(--accent), 0.06);
	}

	.tool-list strong,
	.tool-list small {
		display: block;
	}

	.tool-list strong {
		font: 650 1rem var(--font-display);
	}

	.tool-list small {
		margin-top: 0.45rem;
		color: rgb(var(--gray));
		font-size: 0.78rem;
		line-height: 1.45;
	}

	.tool-icon {
		font-size: 1.05rem;
	}

	@media (max-width: 720px) {
		.gallery-viewport {
			width: 100%;
			margin-left: 0;
			transform: none;
		}

		.home-hero {
			grid-template-columns: 1fr;
			gap: 2.4rem;
			min-height: 0;
			padding: 4.8rem 0 4rem;
		}

		.home-hero h1 {
			font-size: clamp(3.2rem, 18vw, 5.4rem);
		}

		.gallery-heading {
			align-items: flex-start;
			flex-direction: column;
		}

		.gallery-heading > p {
			text-align: left;
		}

		.gallery-track {
			gap: 0.75rem;
			padding-right: 8vw;
		}

		.gallery-slide {
			flex-basis: 88vw;
			width: 88vw;
		}

		.photo-stage {
			height: min(64vh, 520px);
			min-height: 320px;
		}

		.gallery-controls {
			grid-template-columns: auto 1fr auto;
		}

		.featured-post {
			grid-template-columns: 1fr auto;
		}

		.featured-index {
			grid-column: 1 / -1;
		}

		.recent-posts a {
			grid-template-columns: 1fr;
			gap: 0.55rem;
		}

		.tool-list {
			grid-template-columns: 1fr;
		}

		.tool-list a {
			min-height: 108px;
			border-right: 0;
			border-bottom: 1px solid rgba(var(--border), 0.38);
		}

		.tool-list a:last-child {
			border-bottom: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-viewport {
			scroll-behavior: auto;
		}
	}
</style>
