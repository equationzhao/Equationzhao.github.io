---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import bikehomeCover from '../assets/home-gallery/bikehome-cover.webp';
import cornerTraining from '../assets/home-gallery/corner-training.webp';
import forestGroup from '../assets/home-gallery/forest-group.webp';
import summitSelfie from '../assets/home-gallery/summit-selfie.webp';
import zhoushanRide from '../assets/home-gallery/zhoushan-ride.webp';

const gallery = [
	{
		src: summitSelfie,
		alt: '骑行者在山顶公路旁与连绵群山自拍',
		label: 'Climb',
		title: '山巅之后',
		position: 'center 56%',
	},
	{
		src: bikehomeCover,
		alt: '以公路骑行为主题的 Bikehome Momentum 杂志封面',
		label: 'Cover',
		title: 'Momentum',
		position: 'center center',
		fit: 'contain',
	},
	{
		src: zhoushanRide,
		alt: '环舟山骑游大会中正在爬坡的公路车骑行者',
		label: 'Event',
		title: '环舟山 2026',
		position: 'center 63%',
		fit: 'contain',
	},
	{
		src: cornerTraining,
		alt: '穿粉色骑行服的骑行者独自通过山路弯道',
		label: 'Corners',
		title: '过弯',
		position: 'center center',
	},
	{
		src: forestGroup,
		alt: '三名骑行者沿着潮湿的林间公路向前骑行',
		label: 'Together',
		title: '雨林骑行',
		position: 'center 62%',
		fit: 'contain',
	},
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={summitSelfie.src} />
	</head>
	<body>
		<Header title={SITE_TITLE} />
		<main>
			<section class="hero">
				<div>
					<p class="hero-kicker">EQUATIONZHAO / PERSONAL LOG</p>
					<h1>Hi there!<br />你好</h1>
				</div>
				<div class="hero-copy">
					<p>欢迎来到 Eq 的个人网站。这里是我的个人博客，我会在这里分享学习与生活中的内容。</p>
					<p class="hero-cta"><strong>Have fun cycling!</strong></p>
				</div>
			</section>

			<section class="ride-gallery" data-ride-gallery aria-labelledby="ride-gallery-title">
				<header class="gallery-heading">
					<div>
						<p class="gallery-kicker">RIDE ARCHIVE / 骑行切片</p>
						<h2 id="ride-gallery-title">On the road.</h2>
					</div>
					<div class="gallery-status" aria-label="画廊状态">
						<output class="gallery-count" data-gallery-count aria-live="polite">01 — {String(gallery.length).padStart(2, '0')}</output>
						<div class="gallery-controls">
							<button type="button" data-gallery-prev aria-label="上一张照片">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7" /></svg>
							</button>
							<button type="button" data-gallery-toggle aria-label="暂停自动轮播" aria-pressed="false">
								<span data-gallery-toggle-icon aria-hidden="true">Ⅱ</span>
							</button>
							<button type="button" data-gallery-next aria-label="下一张照片">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7" /></svg>
							</button>
						</div>
					</div>
				</header>

				<div
					class="gallery-viewport"
					data-gallery-viewport
					tabindex="0"
					role="region"
					aria-roledescription="carousel"
					aria-label="骑行照片轮播，使用左右方向键切换"
				>
					<div class="gallery-track" data-gallery-track>
						{gallery.map((photo, index) => (
							<figure
								class:list={['gallery-slide', { 'gallery-slide--contain': photo.fit === 'contain' }]}
								data-gallery-slide
								data-index={index}
								data-caption={`${photo.label} / ${photo.title}`}
								aria-hidden={index === 0 ? 'false' : 'true'}
								style={`--photo-position: ${photo.position}; --photo-url: url(${photo.src.src})`}
							>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[640, 960, 1280, 1600]}
									sizes="(max-width: 760px) 94vw, (max-width: 1120px) 72vw, 820px"
									quality={84}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : 'auto'}
								/>
								<figcaption>
									<span>{photo.label}</span>
									<strong>{photo.title}</strong>
								</figcaption>
							</figure>
						))}
					</div>
				</div>

				<div class="gallery-footer">
					<div class="gallery-progress" aria-hidden="true">
						<span data-gallery-progress></span>
					</div>
					<div class="gallery-thumbs" aria-label="选择照片">
						{gallery.map((photo, index) => (
							<button
								type="button"
								class="gallery-thumb"
								data-gallery-thumb
								data-index={index}
								aria-label={`查看照片：${photo.title}`}
								aria-current={index === 0 ? 'true' : 'false'}
								style={`--photo-position: ${photo.position}`}
							>
								<span class="gallery-thumb-image">
									<Image src={photo.src} alt="" width={180} height={116} quality={72} loading="lazy" />
								</span>
								<span class="gallery-thumb-copy">
									<small>{String(index + 1).padStart(2, '0')} / {photo.label}</small>
									<strong>{photo.title}</strong>
								</span>
							</button>
						))}
					</div>
				</div>
				<p class="sr-only" data-gallery-live aria-live="polite">Climb / 山巅之后</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const initRideGallery = () => {
		const root = document.querySelector<HTMLElement>('[data-ride-gallery]:not([data-ready])');
		if (!root) return;

		root.dataset.ready = 'true';
		const viewport = root.querySelector<HTMLElement>('[data-gallery-viewport]');
		const track = root.querySelector<HTMLElement>('[data-gallery-track]');
		const slides = [...root.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
		const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];
		const count = root.querySelector<HTMLOutputElement>('[data-gallery-count]');
		const live = root.querySelector<HTMLElement>('[data-gallery-live]');
		const progress = root.querySelector<HTMLElement>('[data-gallery-progress]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-gallery-toggle]');
		const toggleIcon = root.querySelector<HTMLElement>('[data-gallery-toggle-icon]');
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!viewport || !track || !count || !live || !progress || !toggle || !toggleIcon || slides.length === 0) return;

		let activeIndex = 0;
		let timer = 0;
		let pointerStart = 0;
		let autoplay = !prefersReducedMotion;
		let isHovered = false;
		let hasFocus = false;

		const positionTrack = () => {
			const slide = slides[activeIndex];
			const maxOffset = Math.max(0, track.scrollWidth - viewport.clientWidth);
			const offset = Math.min(slide.offsetLeft, maxOffset);
			track.style.transform = `translate3d(${-offset}px, 0, 0)`;
		};

		const stopTimer = () => {
			window.clearInterval(timer);
			timer = 0;
		};

		const syncTimer = () => {
			stopTimer();
			if (!autoplay || isHovered || hasFocus || document.hidden) return;
			timer = window.setInterval(() => setActive(activeIndex + 1), 6500);
		};

		const syncToggle = () => {
			toggle.setAttribute('aria-pressed', String(!autoplay));
			toggle.setAttribute('aria-label', autoplay ? '暂停自动轮播' : '继续自动轮播');
			toggleIcon.textContent = autoplay ? 'Ⅱ' : '▶';
		};

		const setActive = (nextIndex: number, announce = false) => {
			activeIndex = (nextIndex + slides.length) % slides.length;
			slides.forEach((slide, index) => slide.setAttribute('aria-hidden', String(index !== activeIndex)));
			thumbs.forEach((thumb, index) => thumb.setAttribute('aria-current', String(index === activeIndex)));
			count.value = `${String(activeIndex + 1).padStart(2, '0')} — ${String(slides.length).padStart(2, '0')}`;
			progress.style.setProperty('--gallery-progress', `${((activeIndex + 1) / slides.length) * 100}%`);
			if (announce) live.textContent = slides[activeIndex].dataset.caption ?? '';
			positionTrack();
		};

		const move = (direction: number) => {
			setActive(activeIndex + direction, true);
			syncTimer();
		};

		root.querySelector<HTMLButtonElement>('[data-gallery-prev]')?.addEventListener('click', () => move(-1));
		root.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => move(1));
		thumbs.forEach((thumb, index) => thumb.addEventListener('click', () => {
			setActive(index, true);
			syncTimer();
		}));

		toggle.addEventListener('click', () => {
			autoplay = !autoplay;
			syncToggle();
			syncTimer();
		});

		viewport.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
			event.preventDefault();
			move(event.key === 'ArrowLeft' ? -1 : 1);
		});
		viewport.addEventListener('pointerdown', (event) => {
			pointerStart = event.clientX;
		});
		viewport.addEventListener('pointerup', (event) => {
			const distance = event.clientX - pointerStart;
			if (Math.abs(distance) > 45) move(distance > 0 ? -1 : 1);
		});

		root.addEventListener('mouseenter', () => {
			isHovered = true;
			syncTimer();
		});
		root.addEventListener('mouseleave', () => {
			isHovered = false;
			syncTimer();
		});
		root.addEventListener('focusin', () => {
			hasFocus = true;
			syncTimer();
		});
		root.addEventListener('focusout', () => {
			window.setTimeout(() => {
				hasFocus = root.contains(document.activeElement);
				syncTimer();
			}, 0);
		});

		const handleVisibility = () => syncTimer();
		document.addEventListener('visibilitychange', handleVisibility);
		const resizeObserver = new ResizeObserver(positionTrack);
		resizeObserver.observe(viewport);

		setActive(0);
		syncToggle();
		syncTimer();

		document.addEventListener('astro:before-swap', () => {
			stopTimer();
			resizeObserver.disconnect();
			document.removeEventListener('visibilitychange', handleVisibility);
		}, { once: true });
	};

	initRideGallery();
	document.addEventListener('astro:page-load', initRideGallery);
</script>

<style>
	.hero,
	.ride-gallery {
		background: rgba(var(--surface-1), 0.72);
		border: 1px solid rgba(var(--border), 0.28);
		border-radius: var(--radius-lg);
		box-shadow: var(--surface-shadow);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1.15fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: end;
		padding: clamp(1.5rem, 4vw, 2.75rem);
	}

	.hero-kicker,
	.gallery-kicker {
		margin: 0 0 0.55rem;
		color: rgb(var(--accent));
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.3;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(3rem, 8vw, 5.8rem);
		line-height: 0.88;
		letter-spacing: -0.065em;
	}

	.hero-copy p {
		max-width: 34rem;
		margin-top: 0;
	}

	.hero-cta {
		margin: 1rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.82rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.ride-gallery {
		--gallery-road-blue: #3aa5ff;
		--gallery-marker-yellow: #f4c84b;
		--gallery-brake-red: #ef5c71;
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(10.5rem, 20vw, 13rem);
		gap: clamp(0.7rem, 1.6vw, 1rem);
		margin-top: 1.2rem;
		padding: clamp(0.9rem, 2.2vw, 1.45rem);
		overflow: hidden;
		background:
			radial-gradient(circle at 92% 8%, rgba(58, 165, 255, 0.1), transparent 30%),
			rgba(var(--surface-1), 0.76);
	}

	.gallery-heading,
	.gallery-status,
	.gallery-controls,
	.gallery-footer {
		display: flex;
		align-items: center;
	}

	.gallery-heading {
		grid-column: 1 / -1;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.25rem 0.1rem clamp(0.95rem, 2vw, 1.25rem);
		border-bottom: 1px solid rgba(var(--border), 0.22);
	}

	.gallery-heading h2 {
		margin: 0;
		font-size: clamp(2.1rem, 5vw, 3.85rem);
		line-height: 0.92;
		letter-spacing: -0.05em;
	}

	.gallery-status {
		gap: clamp(0.7rem, 2vw, 1.15rem);
	}

	.gallery-count {
		min-width: 5rem;
		color: rgb(var(--gray));
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-align: right;
	}

	.gallery-controls {
		gap: 0;
		overflow: hidden;
		border: 1px solid rgba(var(--border), 0.34);
		border-radius: 999px;
		background: rgba(var(--surface-0), 0.54);
	}

	.gallery-controls button {
		display: grid;
		place-items: center;
		width: 2.45rem;
		height: 2.45rem;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: color 0.18s ease, background-color 0.18s ease;
	}

	.gallery-controls button + button {
		border-left: 1px solid rgba(var(--border), 0.28);
	}

	.gallery-controls button:hover {
		background: rgba(244, 200, 75, 0.12);
		color: var(--gallery-marker-yellow);
	}

	.gallery-controls button:focus-visible,
	.gallery-thumb:focus-visible,
	.gallery-viewport:focus-visible {
		outline: 2px solid var(--gallery-marker-yellow);
		outline-offset: 3px;
	}

	.gallery-controls svg {
		width: 1.12rem;
		height: 1.12rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	[data-gallery-toggle-icon] {
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1;
	}

	.gallery-viewport {
		grid-column: 1;
		min-width: 0;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: calc(var(--radius-lg) - 6px);
		background: #07101a;
		box-shadow: 0 18px 40px rgba(3, 8, 13, 0.18);
		touch-action: pan-y;
		cursor: grab;
	}

	.gallery-viewport:active {
		cursor: grabbing;
	}

	.gallery-track {
		display: flex;
		gap: 0.8rem;
		width: 100%;
		transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}

	.gallery-slide {
		position: relative;
		flex: 0 0 100%;
		width: 100%;
		aspect-ratio: 16 / 10;
		margin: 0;
		overflow: hidden;
		border-radius: calc(var(--radius-lg) - 7px);
		background: #07101a;
		isolation: isolate;
	}

	.gallery-slide::after {
		content: '';
		position: absolute;
		inset: 36% 0 0;
		z-index: 2;
		background: linear-gradient(transparent, rgba(3, 8, 13, 0.2) 25%, rgba(3, 8, 13, 0.82));
		pointer-events: none;
	}

	.gallery-slide--contain::before {
		content: '';
		position: absolute;
		inset: -2rem;
		z-index: 0;
		background-image: var(--photo-url);
		background-position: var(--photo-position);
		background-size: cover;
		filter: blur(28px) saturate(0.8) brightness(0.45);
		transform: scale(1.08);
		opacity: 0.82;
	}

	.gallery-slide :global(img) {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: cover;
		object-position: var(--photo-position);
		transform: scale(1.005);
		transition: transform 6.5s ease-out, filter 0.45s ease;
	}

	.gallery-slide[aria-hidden='false'] :global(img) {
		transform: scale(1.035);
	}

	.gallery-slide--contain :global(img),
	.gallery-slide--contain[aria-hidden='false'] :global(img) {
		object-fit: contain;
		transform: none;
	}

	.gallery-slide figcaption {
		position: absolute;
		left: clamp(1.15rem, 3vw, 2.15rem);
		bottom: clamp(1rem, 2.5vw, 1.75rem);
		z-index: 3;
		display: grid;
		gap: 0.32rem;
		color: #fff;
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.72);
	}

	.gallery-slide figcaption span {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.64rem;
		font-weight: 750;
		letter-spacing: 0.16em;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.gallery-slide figcaption span::before {
		content: '';
		width: 1.35rem;
		height: 2px;
		background: var(--gallery-marker-yellow);
		box-shadow: 1.5rem 0 0 var(--gallery-brake-red);
	}

	.gallery-slide figcaption strong {
		font-size: clamp(1.55rem, 4vw, 2.65rem);
		letter-spacing: -0.045em;
		line-height: 1;
	}

	.gallery-footer {
		grid-column: 2;
		align-items: stretch;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.gallery-progress {
		position: relative;
		flex: none;
		width: 100%;
		height: 2px;
		overflow: hidden;
		background: rgba(var(--border), 0.34);
	}

	.gallery-progress span {
		display: block;
		width: var(--gallery-progress, 20%);
		height: 100%;
		background: linear-gradient(90deg, var(--gallery-road-blue), var(--gallery-marker-yellow) 72%, var(--gallery-brake-red));
		transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gallery-thumbs {
		display: grid;
		grid-template-rows: repeat(5, minmax(0, 1fr));
		gap: 0.45rem;
		flex: 1;
		min-height: 0;
	}

	.gallery-thumb {
		position: relative;
		display: grid;
		grid-template-columns: minmax(3.4rem, 4.35rem) minmax(0, 1fr);
		gap: 0.62rem;
		align-items: center;
		min-height: 0;
		padding: 0.34rem;
		overflow: hidden;
		border: 1px solid transparent;
		border-radius: 6px;
		background: rgba(var(--surface-0), 0.36);
		color: rgb(var(--gray-dark));
		text-align: left;
		cursor: pointer;
		opacity: 0.58;
		transition: opacity 0.18s ease, border-color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
	}

	.gallery-thumb::before {
		content: '';
		position: absolute;
		inset: 0 auto 0 0;
		width: 2px;
		background: transparent;
		transition: background-color 0.18s ease;
	}

	.gallery-thumb:hover {
		background: rgba(var(--surface-0), 0.62);
		opacity: 0.88;
		transform: translateX(-2px);
	}

	.gallery-thumb[aria-current='true'] {
		border-color: rgba(244, 200, 75, 0.3);
		background: rgba(244, 200, 75, 0.08);
		opacity: 1;
	}

	.gallery-thumb[aria-current='true']::before {
		background: var(--gallery-marker-yellow);
	}

	.gallery-thumb-image {
		display: block;
		aspect-ratio: 1.3;
		overflow: hidden;
		border-radius: 3px;
		background: #07101a;
	}

	.gallery-thumb-image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: cover;
		object-position: var(--photo-position);
		filter: saturate(0.82);
		transition: filter 0.18s ease, transform 0.35s ease;
	}

	.gallery-thumb:hover .gallery-thumb-image :global(img),
	.gallery-thumb[aria-current='true'] .gallery-thumb-image :global(img) {
		filter: saturate(1);
		transform: scale(1.045);
	}

	.gallery-thumb-copy {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.gallery-thumb-copy small {
		overflow: hidden;
		color: rgb(var(--gray));
		font-size: 0.54rem;
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-overflow: ellipsis;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.gallery-thumb-copy strong {
		overflow: hidden;
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1.2;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (max-width: 760px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 1.2rem;
		}

		.hero h1 {
			font-size: clamp(3.1rem, 18vw, 5rem);
		}

		.ride-gallery {
			display: block;
			padding: 0.78rem;
		}

		.gallery-heading {
			align-items: flex-end;
			padding: 0.25rem 0.1rem 0.85rem;
		}

		.gallery-heading h2 {
			font-size: clamp(2rem, 11vw, 3rem);
		}

		.gallery-status {
